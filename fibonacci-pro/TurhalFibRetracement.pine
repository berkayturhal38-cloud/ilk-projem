//@version=6
// Turhal Fib Retracement (2-point, like the classic tool) — flat / mobile-safe
// Place two points on the chart (time+price) and drag them. Author: berkayturhal38
indicator("Turhal Fib Retracement", "Turhal Fib RT", overlay=true, max_lines_count=60, max_labels_count=60, max_boxes_count=20)

gp = "Points (click / drag on chart)"
t1 = input.time(timestamp("2024-01-01 00:00 +0000"), "Point 1 = 100%", confirm=true, group=gp)
p1 = input.price(50.0, "Point 1 = 100%", confirm=true, group=gp)
t2 = input.time(timestamp("2024-02-01 00:00 +0000"), "Point 2 = 0%", confirm=true, group=gp)
p2 = input.price(100.0, "Point 2 = 0%", confirm=true, group=gp)

gs = "Style"
extMode = input.string("Right", "Extend", options=["Right", "Both", "Left", "None"], group=gs)
reverse = input.bool(false, "Reverse", group=gs)
lineW = input.int(1, "Line Width", minval=1, maxval=4, group=gs)
showFill = input.bool(true, "Fill Zones", group=gs)
fillT = input.int(85, "Zone Transparency", minval=50, maxval=98, group=gs)
showConn = input.bool(true, "Trend Line", group=gs)
showLbl = input.bool(true, "Show Labels", group=gs)
showExt = input.bool(true, "Show Extensions (1.272 ... 2.618)", group=gs)
showExtDeep = input.bool(false, "Show Deep Extensions (3.0 ... 4.764)", group=gs)

gc = "Colors"
c0 = input.color(#787b86, "0.0", group=gc)
c236 = input.color(#f23645, "0.236", group=gc)
c382 = input.color(#ff9800, "0.382", group=gc)
c5 = input.color(#4caf50, "0.5", group=gc)
c618 = input.color(#00bcd4, "0.618", group=gc)
c786 = input.color(#2962ff, "0.786", group=gc)
c1 = input.color(#787b86, "1.0", group=gc)
goldCol = input.color(#ffd700, "Golden Zone", group=gc)
ceCol = input.color(#e91e63, "Extensions", group=gc)

extV = extMode == "Both" ? extend.both : extMode == "Left" ? extend.left : extMode == "None" ? extend.none : extend.right
aa = reverse ? p1 : p2
bb = reverse ? p2 : p1
rng = bb - aa
tL = t1 < t2 ? t1 : t2
tR = t1 < t2 ? t2 : t1
goldT = fillT - 25 < 45 ? 45 : fillT - 25

lp0 = aa + rng * 0.0
lp236 = aa + rng * 0.236
lp382 = aa + rng * 0.382
lp5 = aa + rng * 0.5
lp618 = aa + rng * 0.618
lp786 = aa + rng * 0.786
lp1 = aa + rng * 1.0
e1272 = showExt ? aa + rng * 1.272 : na
e1414 = showExt ? aa + rng * 1.414 : na
e1618 = showExt ? aa + rng * 1.618 : na
e200 = showExt ? aa + rng * 2.0 : na
e2272 = showExt ? aa + rng * 2.272 : na
e2414 = showExt ? aa + rng * 2.414 : na
e2618 = showExt ? aa + rng * 2.618 : na
e300 = showExt and showExtDeep ? aa + rng * 3.0 : na
e3272 = showExt and showExtDeep ? aa + rng * 3.272 : na
e3414 = showExt and showExtDeep ? aa + rng * 3.414 : na
e3618 = showExt and showExtDeep ? aa + rng * 3.618 : na
e400 = showExt and showExtDeep ? aa + rng * 4.0 : na
e4236 = showExt and showExtDeep ? aa + rng * 4.236 : na
e4272 = showExt and showExtDeep ? aa + rng * 4.272 : na
e4414 = showExt and showExtDeep ? aa + rng * 4.414 : na
e4618 = showExt and showExtDeep ? aa + rng * 4.618 : na
e4764 = showExt and showExtDeep ? aa + rng * 4.764 : na

var box z1 = box.new(na, na, na, na, xloc=xloc.bar_time, border_color=color.new(color.gray, 100))
var box z2 = box.new(na, na, na, na, xloc=xloc.bar_time, border_color=color.new(color.gray, 100))
var box z3 = box.new(na, na, na, na, xloc=xloc.bar_time, border_color=color.new(color.gray, 100))
var box z4 = box.new(na, na, na, na, xloc=xloc.bar_time, border_color=color.new(color.gray, 100))
var box z5 = box.new(na, na, na, na, xloc=xloc.bar_time, border_color=color.new(color.gray, 100))
var box z6 = box.new(na, na, na, na, xloc=xloc.bar_time, border_color=color.new(color.gray, 100))

box.set_extend(z1, extV)
box.set_lefttop(z1, tL, showFill ? math.max(lp0, lp236) : na)
box.set_rightbottom(z1, tR, showFill ? math.min(lp0, lp236) : na)
box.set_bgcolor(z1, color.new(c236, fillT))
box.set_extend(z2, extV)
box.set_lefttop(z2, tL, showFill ? math.max(lp236, lp382) : na)
box.set_rightbottom(z2, tR, showFill ? math.min(lp236, lp382) : na)
box.set_bgcolor(z2, color.new(c382, fillT))
box.set_extend(z3, extV)
box.set_lefttop(z3, tL, showFill ? math.max(lp382, lp5) : na)
box.set_rightbottom(z3, tR, showFill ? math.min(lp382, lp5) : na)
box.set_bgcolor(z3, color.new(c5, fillT))
box.set_extend(z4, extV)
box.set_lefttop(z4, tL, showFill ? math.max(lp5, lp618) : na)
box.set_rightbottom(z4, tR, showFill ? math.min(lp5, lp618) : na)
box.set_bgcolor(z4, color.new(c618, fillT))
box.set_extend(z5, extV)
box.set_lefttop(z5, tL, showFill ? math.max(lp618, lp786) : na)
box.set_rightbottom(z5, tR, showFill ? math.min(lp618, lp786) : na)
box.set_bgcolor(z5, color.new(goldCol, goldT))
box.set_extend(z6, extV)
box.set_lefttop(z6, tL, showFill ? math.max(lp786, lp1) : na)
box.set_rightbottom(z6, tR, showFill ? math.min(lp786, lp1) : na)
box.set_bgcolor(z6, color.new(c1, fillT))

var line l0 = line.new(na, na, na, na, xloc=xloc.bar_time, color=c0, width=lineW)
var line l236 = line.new(na, na, na, na, xloc=xloc.bar_time, color=c236, width=lineW)
var line l382 = line.new(na, na, na, na, xloc=xloc.bar_time, color=c382, width=lineW)
var line l5 = line.new(na, na, na, na, xloc=xloc.bar_time, color=c5, width=lineW)
var line l618 = line.new(na, na, na, na, xloc=xloc.bar_time, color=c618, width=lineW + 1)
var line l786 = line.new(na, na, na, na, xloc=xloc.bar_time, color=c786, width=lineW)
var line l1 = line.new(na, na, na, na, xloc=xloc.bar_time, color=c1, width=lineW)
var line eL1 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL2 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL3 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL4 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL5 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL6 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL7 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL8 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL9 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL10 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL11 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL12 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL13 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL14 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL15 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL16 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)
var line eL17 = line.new(na, na, na, na, xloc=xloc.bar_time, color=ceCol, width=lineW, style=line.style_dashed)

line.set_extend(l0, extV)
line.set_xy1(l0, tL, lp0)
line.set_xy2(l0, tR, lp0)
line.set_extend(l236, extV)
line.set_xy1(l236, tL, lp236)
line.set_xy2(l236, tR, lp236)
line.set_extend(l382, extV)
line.set_xy1(l382, tL, lp382)
line.set_xy2(l382, tR, lp382)
line.set_extend(l5, extV)
line.set_xy1(l5, tL, lp5)
line.set_xy2(l5, tR, lp5)
line.set_extend(l618, extV)
line.set_xy1(l618, tL, lp618)
line.set_xy2(l618, tR, lp618)
line.set_extend(l786, extV)
line.set_xy1(l786, tL, lp786)
line.set_xy2(l786, tR, lp786)
line.set_extend(l1, extV)
line.set_xy1(l1, tL, lp1)
line.set_xy2(l1, tR, lp1)
line.set_extend(eL1, extV)
line.set_xy1(eL1, tL, e1272)
line.set_xy2(eL1, tR, e1272)
line.set_extend(eL2, extV)
line.set_xy1(eL2, tL, e1414)
line.set_xy2(eL2, tR, e1414)
line.set_extend(eL3, extV)
line.set_xy1(eL3, tL, e1618)
line.set_xy2(eL3, tR, e1618)
line.set_extend(eL4, extV)
line.set_xy1(eL4, tL, e200)
line.set_xy2(eL4, tR, e200)
line.set_extend(eL5, extV)
line.set_xy1(eL5, tL, e2272)
line.set_xy2(eL5, tR, e2272)
line.set_extend(eL6, extV)
line.set_xy1(eL6, tL, e2414)
line.set_xy2(eL6, tR, e2414)
line.set_extend(eL7, extV)
line.set_xy1(eL7, tL, e2618)
line.set_xy2(eL7, tR, e2618)
line.set_extend(eL8, extV)
line.set_xy1(eL8, tL, e300)
line.set_xy2(eL8, tR, e300)
line.set_extend(eL9, extV)
line.set_xy1(eL9, tL, e3272)
line.set_xy2(eL9, tR, e3272)
line.set_extend(eL10, extV)
line.set_xy1(eL10, tL, e3414)
line.set_xy2(eL10, tR, e3414)
line.set_extend(eL11, extV)
line.set_xy1(eL11, tL, e3618)
line.set_xy2(eL11, tR, e3618)
line.set_extend(eL12, extV)
line.set_xy1(eL12, tL, e400)
line.set_xy2(eL12, tR, e400)
line.set_extend(eL13, extV)
line.set_xy1(eL13, tL, e4236)
line.set_xy2(eL13, tR, e4236)
line.set_extend(eL14, extV)
line.set_xy1(eL14, tL, e4272)
line.set_xy2(eL14, tR, e4272)
line.set_extend(eL15, extV)
line.set_xy1(eL15, tL, e4414)
line.set_xy2(eL15, tR, e4414)
line.set_extend(eL16, extV)
line.set_xy1(eL16, tL, e4618)
line.set_xy2(eL16, tR, e4618)
line.set_extend(eL17, extV)
line.set_xy1(eL17, tL, e4764)
line.set_xy2(eL17, tR, e4764)

var line conn = line.new(na, na, na, na, xloc=xloc.bar_time, color=color.new(color.gray, 0), width=1, style=line.style_dashed)
line.set_xy1(conn, showConn ? t1 : na, showConn ? p1 : na)
line.set_xy2(conn, showConn ? t2 : na, showConn ? p2 : na)

var label b0 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=c0, size=size.small)
var label b236 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=c236, size=size.small)
var label b382 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=c382, size=size.small)
var label b5 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=c5, size=size.small)
var label b618 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=c618, size=size.small)
var label b786 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=c786, size=size.small)
var label b1 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=c1, size=size.small)
var label eB1 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB2 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB3 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB4 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB5 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB6 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB7 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB8 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB9 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB10 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB11 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB12 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB13 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB14 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB15 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB16 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)
var label eB17 = label.new(na, na, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 20), textcolor=ceCol, size=size.small)

label.set_xy(b0, tR, lp0)
label.set_text(b0, showLbl ? "0.0  " + str.tostring(lp0, format.mintick) : "")
label.set_xy(b236, tR, lp236)
label.set_text(b236, showLbl ? "0.236  " + str.tostring(lp236, format.mintick) : "")
label.set_xy(b382, tR, lp382)
label.set_text(b382, showLbl ? "0.382  " + str.tostring(lp382, format.mintick) : "")
label.set_xy(b5, tR, lp5)
label.set_text(b5, showLbl ? "0.5  " + str.tostring(lp5, format.mintick) : "")
label.set_xy(b618, tR, lp618)
label.set_text(b618, showLbl ? "0.618  " + str.tostring(lp618, format.mintick) : "")
label.set_xy(b786, tR, lp786)
label.set_text(b786, showLbl ? "0.786  " + str.tostring(lp786, format.mintick) : "")
label.set_xy(b1, tR, lp1)
label.set_text(b1, showLbl ? "1.0  " + str.tostring(lp1, format.mintick) : "")
label.set_xy(eB1, tR, e1272)
label.set_text(eB1, showLbl and not na(e1272) ? "1.272  " + str.tostring(e1272, format.mintick) : "")
label.set_xy(eB2, tR, e1414)
label.set_text(eB2, showLbl and not na(e1414) ? "1.414  " + str.tostring(e1414, format.mintick) : "")
label.set_xy(eB3, tR, e1618)
label.set_text(eB3, showLbl and not na(e1618) ? "1.618  " + str.tostring(e1618, format.mintick) : "")
label.set_xy(eB4, tR, e200)
label.set_text(eB4, showLbl and not na(e200) ? "2.0  " + str.tostring(e200, format.mintick) : "")
label.set_xy(eB5, tR, e2272)
label.set_text(eB5, showLbl and not na(e2272) ? "2.272  " + str.tostring(e2272, format.mintick) : "")
label.set_xy(eB6, tR, e2414)
label.set_text(eB6, showLbl and not na(e2414) ? "2.414  " + str.tostring(e2414, format.mintick) : "")
label.set_xy(eB7, tR, e2618)
label.set_text(eB7, showLbl and not na(e2618) ? "2.618  " + str.tostring(e2618, format.mintick) : "")
label.set_xy(eB8, tR, e300)
label.set_text(eB8, showLbl and not na(e300) ? "3.0  " + str.tostring(e300, format.mintick) : "")
label.set_xy(eB9, tR, e3272)
label.set_text(eB9, showLbl and not na(e3272) ? "3.272  " + str.tostring(e3272, format.mintick) : "")
label.set_xy(eB10, tR, e3414)
label.set_text(eB10, showLbl and not na(e3414) ? "3.414  " + str.tostring(e3414, format.mintick) : "")
label.set_xy(eB11, tR, e3618)
label.set_text(eB11, showLbl and not na(e3618) ? "3.618  " + str.tostring(e3618, format.mintick) : "")
label.set_xy(eB12, tR, e400)
label.set_text(eB12, showLbl and not na(e400) ? "4.0  " + str.tostring(e400, format.mintick) : "")
label.set_xy(eB13, tR, e4236)
label.set_text(eB13, showLbl and not na(e4236) ? "4.236  " + str.tostring(e4236, format.mintick) : "")
label.set_xy(eB14, tR, e4272)
label.set_text(eB14, showLbl and not na(e4272) ? "4.272  " + str.tostring(e4272, format.mintick) : "")
label.set_xy(eB15, tR, e4414)
label.set_text(eB15, showLbl and not na(e4414) ? "4.414  " + str.tostring(e4414, format.mintick) : "")
label.set_xy(eB16, tR, e4618)
label.set_text(eB16, showLbl and not na(e4618) ? "4.618  " + str.tostring(e4618, format.mintick) : "")
label.set_xy(eB17, tR, e4764)
label.set_text(eB17, showLbl and not na(e4764) ? "4.764  " + str.tostring(e4764, format.mintick) : "")
