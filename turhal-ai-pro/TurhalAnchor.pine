//@version=6
// ============================================================================
//  TURHAL ANCHOR TEŞHİS  —  vB/C (BOS-onaylı in-play displacement leg)
//  AMAÇ: Profesyonel traderın manuel Fibonacci çekerken seçeceği 1. (A1) ve 2.
//        (A2) anchor noktalarını algoritmik taklit etmek.
//  ÇİZİM: A1 anchor + A2 anchor + leg çizgisi + GÖRSEL Fib seti (yalnızca teşhis).
//  YOK: EMA, strateji, LONG/SHORT sinyali, TP/SL. Fib yalnızca GÖRSEL; mantığa katılmaz.
//  MOTOR: DC (k*ATR) yalnızca swing ONAYI için; BOS (close kırılımı) leg seçimi.
//         4H kaynak, request.security lookahead_off, non-repaint, future-leak yok.
//         State yalnızca yeni KAPANMIŞ 4H barında bir kez işlenir (newBar4 + [1]).
//  License: MPL-2.0
// ============================================================================
indicator("Turhal Anchor Teşhis", "Turhal Anchor", overlay = true, max_lines_count = 40, max_labels_count = 20)

// ============================================================================
//  GİRDİLER
// ============================================================================
res       = input.timeframe("240", "Anchor Kaynak Zaman Dilimi")
atrLen    = input.int(14, "ATR Periyodu (onay için)", minval = 1)
k         = input.float(3.0, "DC Onay Eşiği (k x ATR)", minval = 0.1, step = 0.1)
showPanel = input.bool(true, "Debug Panelini Göster")
labelGapK = input.float(0.35, "Etiket Dikey Aralığı (x ATR)", minval = 0.0, step = 0.05)

// ============================================================================
//  4H ONAYLI VERİ  (lookahead_off; [1] ile yalnızca KAPANMIŞ 4H barı kullanılır)
// ============================================================================
[h4, l4, c4, a4, t4] = request.security(syminfo.tickerid, res, [high, low, close, ta.atr(atrLen), time], lookahead = barmerge.lookahead_off)
newBar4 = t4 != t4[1]   // yeni 4H barı başladı => önceki 4H barı KAPANDI

// ============================================================================
//  DURUM DEĞİŞKENLERİ
// ============================================================================
// DC motoru
var int   dcMode  = 0    // +1 = HIGH arıyor, -1 = LOW arıyor, 0 = başlatılmadı
var float curHi   = na
var int   curHiT  = na
var float curLo   = na
var int   curLoT  = na
var float confHi  = na   // son onaylı swing HIGH
var int   confHiT = na
var float confLo  = na   // son onaylı swing LOW
var int   confLoT = na
// Yapı / leg
var int   structDir = 0  // +1 = YUKARI (LOW->HIGH), -1 = AŞAĞI (HIGH->LOW), 0 = yok
var float a1P = na
var int   a1T = na
var float a2P = na
var int   a2T = na
// teşhis sayaçları
var int   nFlip = 0
var int   nBar4 = 0

// ---- H2 PIVOT-CONFLUENCE DENSITY SCAN durumu (görsel/teşhis; motora KATILMAZ) ----
// Seviye sırası: 0-6 ana [0,0.236,0.382,0.5,0.618,0.786,1], 7-12 ara [0.118,0.309,0.441,0.559,0.702,0.893]
var float[] allR       = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0, 0.118, 0.309, 0.441, 0.559, 0.702, 0.893)
var int[]   levelScore = array.new_int(13, 0)    // 0-100 H2 Score (her recompute'ta yeniden)
// Kapalı 4H geçmişi (A1->now full recompute için; cap 500)
var float[] hH = array.new_float()
var float[] hL = array.new_float()
var float[] hC = array.new_float()
var float[] hA = array.new_float()
var int[]   hT = array.new_int()

// ============================================================================
//  STATE MACHINE  (yalnızca kapanmış 4H barında, bir kez)
// ============================================================================
if newBar4
    H4 = h4[1]
    L4 = l4[1]
    C4 = c4[1]
    A4 = a4[1]
    T4 = t4[1]
    nBar4 := nBar4 + 1

    // ---- DC motoru: onaylı swing üretimi (ATR yalnızca ONAY için) ----
    if dcMode == 0
        dcMode := 1
        curHi := H4
        curHiT := T4
        curLo := L4
        curLoT := T4
    else if dcMode == 1
        if H4 > curHi
            curHi := H4
            curHiT := T4
        if not na(A4) and C4 <= curHi - k * A4
            confHi := curHi
            confHiT := curHiT
            dcMode := -1
            curLo := L4
            curLoT := T4
    else if dcMode == -1
        if L4 < curLo
            curLo := L4
            curLoT := T4
        if not na(A4) and C4 >= curLo + k * A4
            confLo := curLo
            confLoT := curLoT
            dcMode := 1
            curHi := H4
            curHiT := T4

    // ---- Yapı / BOS: leg seçimi (yalnızca close, önceki onaylı KARŞI swing) ----
    bullBOS = not na(confHi) and C4 > confHi
    bearBOS = not na(confLo) and C4 < confLo
    if bullBOS and structDir != 1 and not na(confLo)
        structDir := 1
        a1P := confLo          // köken: yükselişi başlatan dip
        a1T := confLoT
        a2P := H4              // terminus: impuls tepesi (uzayacak)
        a2T := T4
        nFlip := nFlip + 1
    else if bearBOS and structDir != -1 and not na(confHi)
        structDir := -1
        a1P := confHi          // köken: düşüşü başlatan tepe
        a1T := confHiT
        a2P := L4
        a2T := T4
        nFlip := nFlip + 1

    // ---- A2 aynı yönde yeni ekstremle GÜNCELLENİR (uzar) ----
    if structDir == 1 and H4 > a2P
        a2P := H4
        a2T := T4
    if structDir == -1 and L4 < a2P
        a2P := L4
        a2T := T4

    // ---- H2: kapanmış 4H barını geçmişe ekle (cap 500; A1->now recompute için) ----
    array.push(hH, H4)
    array.push(hL, L4)
    array.push(hC, C4)
    array.push(hA, A4)
    array.push(hT, T4)
    if array.size(hT) > 500
        array.shift(hH)
        array.shift(hL)
        array.shift(hC)
        array.shift(hA)
        array.shift(hT)

// ============================================================================
//  ÇİZİM  (yalnızca A1, A2 ve aralarındaki çizgi — son barda güncellenir)
// ============================================================================
var line  legLn = na
var label a1Lb  = na
var label a2Lb  = na
if barstate.islast
    line.delete(legLn)
    label.delete(a1Lb)
    label.delete(a2Lb)
    if structDir != 0 and not na(a1T) and not na(a2T)
        col = structDir == 1 ? color.new(color.green, 0) : color.new(color.red, 0)
        legLn := line.new(a1T, a1P, a2T, a2P, xloc = xloc.bar_time, color = col, width = 2)
        a1Lb := label.new(a1T, a1P, "A1  " + str.tostring(a1P, format.mintick), xloc = xloc.bar_time, style = structDir == 1 ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 15), textcolor = color.white, size = size.small)
        a2Lb := label.new(a2T, a2P, "A2  " + str.tostring(a2P, format.mintick), xloc = xloc.bar_time, style = structDir == 1 ? label.style_label_down : label.style_label_up, color = col, textcolor = color.white, size = size.small)

// ============================================================================
//  H2 — PIVOT-CONFLUENCE DENSITY SCAN v1  (görsel/teşhis; anchor motoruna KATILMAZ)
//  PRENSİP: Güçlü Fib seviyesi = çevresinde ONAYLI swing dönüşü oluşmuş ve fiyatın
//  sonrasında anlamlı displacement yaptığı seviyedir. Temas/mum sayımı YOK.
//  Pencere: A1 -> son KAPANMIŞ 4H bar (buffer max 500). Her hesap FULL RECOMPUTE;
//  A1/A2 değişince eski skor taşınmaz, güncel Fib geometrisiyle geçmiş yeniden taranır.
//  PIVOT: volatilite-adaptif onay — lokal ekstrem, sonrasında >= 1.0 x pivotATR ters
//  yönlü displacement (4H close) gerçekleşince CONFIRMED. Gelecek veri yok.
//  KALİTE: q = strength * (0.5 + 0.5*proximity) * recency
//    strength  = min(maxExcursion / pivotATR, 3) / 3   (0-1, displacement ana faktör)
//    proximity = 1 - min(|pivot - Lv| / zoneHalf, 1)   (0-1, çizgiye yakın daha değerli)
//    recency   = 0.4 + 0.6 * normalizedTime            (A1 civarı ~0.4, güncel ~1.0)
//  zoneHalf = min(0.35*pivotATR, 0.025*|A2-A1|). Dedup: aynı seviyede 6 kapanmış 4H
//  bardan yakın pivotlarda yalnızca büyük displacement kazanır. Seviye başına en
//  kaliteli 5 q toplanır: Score = round(100*(1-exp(-RAW/1.8))).
//  Ceza / acceptance / touch / volume / trend / sinyal YOK (v1 yalnızca dönüş kalitesi).
//  Yalnızca kapanmış 4H mumlar (hH/hL/hC/hA/hT); lookahead yok, repaint yok.
// ============================================================================
if barstate.islast and structDir != 0 and not na(a1P) and not na(a2P) and not na(a1T) and array.size(hT) > 0
    nHist   = array.size(hT)
    nowT    = array.get(hT, nHist - 1)
    span    = math.max(nowT - a1T, 1)
    legAbs2 = math.abs(a1P - a2P)

    // ---- 1) Onaylı pivot tespiti (alternating HIGH/LOW; 1.0 x pivotATR onayı) ----
    pvP  = array.new_float()   // pivot fiyat
    pvT  = array.new_int()     // pivot zaman
    pvB  = array.new_int()     // pivot buffer index (6-bar dedup için)
    pvA  = array.new_float()   // pivot barındaki ATR (pivotATR)
    pvTy = array.new_int()     // +1 = HIGH, -1 = LOW
    int   pMode = 0            // 0 = başlatılmadı, +1 = HIGH arıyor, -1 = LOW arıyor
    float pHi   = na
    int   pHiB  = 0
    int   pHiT  = 0
    float pHiA  = na
    float pLo   = na
    int   pLoB  = 0
    int   pLoT  = 0
    float pLoA  = na
    for b = 0 to nHist - 1
        bT = array.get(hT, b)
        if bT >= a1T
            bH = array.get(hH, b)
            bL = array.get(hL, b)
            bC = array.get(hC, b)
            bA = array.get(hA, b)
            if pMode == 0
                if na(pHi) or bH > pHi
                    pHi := bH
                    pHiB := b
                    pHiT := bT
                    pHiA := bA
                if na(pLo) or bL < pLo
                    pLo := bL
                    pLoB := b
                    pLoT := bT
                    pLoA := bA
                if not na(pHiA) and bC <= pHi - pHiA
                    array.push(pvP, pHi)
                    array.push(pvT, pHiT)
                    array.push(pvB, pHiB)
                    array.push(pvA, pHiA)
                    array.push(pvTy, 1)
                    pMode := -1
                    pLo := bL
                    pLoB := b
                    pLoT := bT
                    pLoA := bA
                else if not na(pLoA) and bC >= pLo + pLoA
                    array.push(pvP, pLo)
                    array.push(pvT, pLoT)
                    array.push(pvB, pLoB)
                    array.push(pvA, pLoA)
                    array.push(pvTy, -1)
                    pMode := 1
                    pHi := bH
                    pHiB := b
                    pHiT := bT
                    pHiA := bA
            else if pMode == 1                       // HIGH adayı izleniyor
                if bH > pHi
                    pHi := bH
                    pHiB := b
                    pHiT := bT
                    pHiA := bA
                if not na(pHiA) and bC <= pHi - pHiA // 1.0 x ATR aşağı displacement -> CONFIRMED
                    array.push(pvP, pHi)
                    array.push(pvT, pHiT)
                    array.push(pvB, pHiB)
                    array.push(pvA, pHiA)
                    array.push(pvTy, 1)
                    pMode := -1
                    pLo := bL
                    pLoB := b
                    pLoT := bT
                    pLoA := bA
            else                                     // LOW adayı izleniyor
                if bL < pLo
                    pLo := bL
                    pLoB := b
                    pLoT := bT
                    pLoA := bA
                if not na(pLoA) and bC >= pLo + pLoA // 1.0 x ATR yukarı displacement -> CONFIRMED
                    array.push(pvP, pLo)
                    array.push(pvT, pLoT)
                    array.push(pvB, pLoB)
                    array.push(pvA, pLoA)
                    array.push(pvTy, -1)
                    pMode := 1
                    pHi := bH
                    pHiB := b
                    pHiT := bT
                    pHiA := bA

    // ---- 2) Pivot başına maxExcursion (alternating: sonraki karşı pivota kadar) ----
    nPv = array.size(pvP)
    pvE = array.new_float()
    if nPv > 0
        for j = 0 to nPv - 1
            e = 0.0
            if j < nPv - 1
                e := math.abs(array.get(pvP, j) - array.get(pvP, j + 1))
            else
                // son pivot: pencere sonuna kadarki karşı yönlü koşu (running ekstrem)
                e := array.get(pvTy, j) == 1 ? (na(pLo) ? 0.0 : array.get(pvP, j) - pLo) : (na(pHi) ? 0.0 : pHi - array.get(pvP, j))
            array.push(pvE, math.max(e, 0.0))

    // ---- 3) Seviye başına confluence: dedup (6 bar) + top-5 q + 0-100 Score ----
    for idx = 0 to 12
        rr = array.get(allR, idx)
        Lv = a2P + rr * (a1P - a2P)
        qArr  = array.new_float()
        lastB = -999               // bu seviyede kabul edilen son pivotun buffer index'i
        lastD = -1.0               // ve displacement'ı (dedup: büyük olan kazanır)
        if nPv > 0
            for j = 0 to nPv - 1
                pAtr = array.get(pvA, j)
                if not na(pAtr) and pAtr > 0
                    zHalf = math.min(0.35 * pAtr, 0.025 * legAbs2)
                    dist  = math.abs(array.get(pvP, j) - Lv)
                    if zHalf > 0 and dist <= zHalf
                        exc      = array.get(pvE, j)
                        dispATR  = math.min(exc / pAtr, 3.0)
                        strength = dispATR / 3.0
                        prox     = 1.0 - math.min(dist / zHalf, 1.0)
                        rec      = 0.4 + 0.6 * math.max(0.0, math.min(1.0, (array.get(pvT, j) - a1T) / span))
                        q        = strength * (0.5 + 0.5 * prox) * rec
                        if array.size(qArr) > 0 and array.get(pvB, j) - lastB < 6
                            if dispATR > lastD     // 6 bardan yakın: büyük displacement kazanır
                                array.set(qArr, array.size(qArr) - 1, q)
                                lastB := array.get(pvB, j)
                                lastD := dispATR
                        else
                            array.push(qArr, q)
                            lastB := array.get(pvB, j)
                            lastD := dispATR
        raw = 0.0
        nq  = array.size(qArr)
        if nq > 0
            array.sort(qArr, order.descending)     // en kaliteli 5 pivot
            for m = 0 to math.min(4, nq - 1)
                raw := raw + array.get(qArr, m)
        array.set(levelScore, idx, math.round(100 * (1 - math.exp(-raw / 1.8))))

// ============================================================================
//  GÖRSEL FIBONACCI SETİ  (yalnızca teşhis; a1P/a2P motoruna DOKUNMAZ)
//  TradingView Fib: 0 seviyesi A2 (terminus), 1.0 seviyesi A1 (köken).
//  price(r) = a2P + r*(a1P - a2P) -> HIGH->LOW ve LOW->HIGH otomatik doğru.
//  Tek aktif set: her çizimde eskiler silinir. Sinyal/strateji/S-R DEĞİL.
// ============================================================================
fibCol(float r) => r == 0.0 or r == 1.0 ? color.new(color.gray, 0) : r == 0.5 ? color.new(color.orange, 0) : (r == 0.618 or r == 0.382) ? color.new(color.teal, 0) : color.new(color.blue, 20)

// ---- ETİKET YERLEŞİM EŞLEMESİ (yalnızca görsel; seviye/skor hesabına dokunmaz) ----
// ordR = 13 oran, ORAN-SIRALI; ordI = her oranın levelScore/allR index'i (0-6 ana, 7-12 ara)
var float[] ordR = array.from(0.0, 0.118, 0.236, 0.309, 0.382, 0.441, 0.5, 0.559, 0.618, 0.702, 0.786, 0.893, 1.0)
var int[]   ordI = array.from(0, 7, 1, 8, 2, 9, 3, 10, 4, 11, 5, 12, 6)

var line[]  fibLn = array.new_line()
var label[] fibLb = array.new_label()
if barstate.islast
    for ln in fibLn
        line.delete(ln)
    for lb in fibLb
        label.delete(lb)
    array.clear(fibLn)
    array.clear(fibLb)
    if structDir != 0 and not na(a1P) and not na(a2P) and not na(a1T) and not na(a2T)
        xStart = a1T < a2T ? a1T : a2T
        xEnd   = a1T < a2T ? a2T : a1T
        // ---- Etiket anti-overlap: fiyat-sıralı tek geçişli greedy istifleme ----
        // minGap = labelGapK x SON KAPANMIŞ 4H ATR (bar içinde sabit -> zıplama/repaint yok).
        // Çizgi GERÇEK fiyatta kalır; yalnızca etiket kayar, kayan etiket connector ile bağlanır.
        // Yukarıdan aşağı: y_i = min(fiyat_i, öncekiY - minGap) -> sıra asla bozulmaz, deterministik.
        stATR  = array.size(hA) > 0 ? array.get(hA, array.size(hA) - 1) : a4
        minGap = na(stATR) ? 0.0 : labelGapK * stATR
        prevY  = float(na)
        for kk = 0 to 12
            s   = a1P > a2P ? 12 - kk : kk          // iterasyon daima YUKARIDAN AŞAĞI fiyat sırasında
            rr  = array.get(ordR, s)
            li  = array.get(ordI, s)
            pr  = a2P + rr * (a1P - a2P)
            sco = array.get(levelScore, li)
            isMain = li < 7
            fc = isMain ? (sco < 25 ? color.new(fibCol(rr), 55) : fibCol(rr)) : (sco < 25 ? color.new(color.gray, 70) : color.new(color.gray, 45))
            lw = sco >= 60 ? 3 : sco >= 25 ? 2 : 1
            // seviye çizgisi HER ZAMAN gerçek Fib fiyatında
            ln = line.new(xStart, pr, xEnd, pr, xloc = xloc.bar_time, extend = extend.right, color = fc, style = isMain and (rr == 0.0 or rr == 1.0) ? line.style_solid : line.style_dashed, width = lw)
            array.push(fibLn, ln)
            // etiket yerleşimi: çakışıyorsa minGap kadar aşağı it
            y = pr
            if not na(prevY) and minGap > 0 and y > prevY - minGap
                y := prevY - minGap
            prevY := y
            // etiket gerçek seviyeden kaydıysa ince connector çiz
            if math.abs(y - pr) > syminfo.mintick
                cn = line.new(time, pr, time, y, xloc = xloc.bar_time, color = color.new(color.gray, 55), style = line.style_dotted, width = 1)
                array.push(fibLn, cn)
            lb = label.new(time, y, str.tostring(rr, "0.000") + " | " + str.tostring(pr, format.mintick) + " | H2:" + str.tostring(sco), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, isMain ? 20 : 55), textcolor = fc, size = isMain ? size.small : size.tiny)
            array.push(fibLb, lb)

// ============================================================================
//  DEBUG PANELİ
// ============================================================================
f_t(int t) => na(t) ? "-" : str.format_time(t, "yy-MM-dd HH:mm", syminfo.timezone)
f_p(float p) => na(p) ? "-" : str.tostring(p, format.mintick)
tc(table tb, int c, int r, string s, color bg) => table.cell(tb, c, r, s, text_color = color.white, bgcolor = bg, text_size = size.small)

dirTxt  = structDir == 1 ? "YUKARI (LOW->HIGH)" : structDir == -1 ? "AŞAĞI (HIGH->LOW)" : "-"
dirCol  = structDir == 1 ? color.new(color.green, 30) : structDir == -1 ? color.new(color.red, 30) : color.new(color.gray, 40)
dcTxt   = dcMode == 1 ? "HIGH arıyor" : dcMode == -1 ? "LOW arıyor" : "-"
legAbs  = na(a1P) or na(a2P) ? na : math.abs(a2P - a1P)
legPct  = na(a1P) or na(a2P) or a1P == 0 ? na : (a2P - a1P) / a1P * 100
legTxt  = na(legAbs) ? "-" : f_p(legAbs) + "  (" + str.tostring(legPct, "0.0") + "%)"
thrTxt  = na(a4) ? "-" : str.tostring(k, "0.0") + " x " + f_p(a4) + " = " + f_p(k * a4)

// H2: en güçlü seviye (panel için; yalnızca okuma)
bestI = 0
bestS = -1
for i2 = 0 to 12
    s2 = array.get(levelScore, i2)
    if s2 > bestS
        bestS := s2
        bestI := i2
bestR = array.get(allR, bestI)
bestP = na(a1P) or na(a2P) ? na : a2P + bestR * (a1P - a2P)

hd = color.new(color.black, 10)
kb = color.new(color.black, 25)
var table dbg = table.new(position.top_right, 2, 16, border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)
if showPanel and barstate.islast
    tc(dbg, 0, 0,  "TURHAL ANCHOR",   hd)
    tc(dbg, 1, 0,  "Model B/C",       hd)
    tc(dbg, 0, 1,  "Kaynak TF",       kb)
    tc(dbg, 1, 1,  res,               kb)
    tc(dbg, 0, 2,  "Yapı yönü",       kb)
    tc(dbg, 1, 2,  dirTxt,            dirCol)
    tc(dbg, 0, 3,  "A1 fiyat",        kb)
    tc(dbg, 1, 3,  f_p(a1P),          color.new(color.blue, 40))
    tc(dbg, 0, 4,  "A1 zaman",        kb)
    tc(dbg, 1, 4,  f_t(a1T),          kb)
    tc(dbg, 0, 5,  "A2 fiyat",        kb)
    tc(dbg, 1, 5,  f_p(a2P),          color.new(color.blue, 40))
    tc(dbg, 0, 6,  "A2 zaman",        kb)
    tc(dbg, 1, 6,  f_t(a2T),          kb)
    tc(dbg, 0, 7,  "Leg boyu",        kb)
    tc(dbg, 1, 7,  legTxt,            kb)
    tc(dbg, 0, 8,  "DC modu",         kb)
    tc(dbg, 1, 8,  dcTxt,             kb)
    tc(dbg, 0, 9,  "Onaylı Tepe",     kb)
    tc(dbg, 1, 9,  f_p(confHi),       kb)
    tc(dbg, 0, 10, "Onaylı Dip",      kb)
    tc(dbg, 1, 10, f_p(confLo),       kb)
    tc(dbg, 0, 11, "DC eşiği (k·ATR)", kb)
    tc(dbg, 1, 11, thrTxt,            kb)
    tc(dbg, 0, 12, "Flip / 4H bar",   kb)
    tc(dbg, 1, 12, str.tostring(nFlip) + " / " + str.tostring(nBar4), kb)
    tc(dbg, 0, 13, "En güçlü H2 oran",  kb)
    tc(dbg, 1, 13, structDir == 0 ? "-" : str.tostring(bestR, "0.000"), color.new(color.purple, 40))
    tc(dbg, 0, 14, "En güçlü H2 fiyat", kb)
    tc(dbg, 1, 14, structDir == 0 ? "-" : f_p(bestP), color.new(color.purple, 40))
    tc(dbg, 0, 15, "En yüksek H2 Score", kb)
    tc(dbg, 1, 15, structDir == 0 ? "-" : str.tostring(bestS) + " / 100", color.new(bestS >= 60 ? color.green : bestS >= 25 ? color.orange : color.gray, 40))
