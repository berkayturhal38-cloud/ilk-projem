//@version=6
// ============================================================================
//  TURHAL TEST 1  —  v1.0
//  AMAÇ: TradingView Strategy Tester emir motorunun (strategy.entry /
//        strategy.exit) güvenilir çalıştığını DOĞRULAMAK. Kârlılık hedeflenmez.
//  KURAL: Basit, repaint'siz sinyal. Tek pozisyon. Sabit SL/TP. Başka özellik YOK.
//  Bu dosya bağımsızdır; Lite veya diğer strategy dosyalarına dokunmaz.
//  License: MPL-2.0
// ============================================================================
strategy("Turhal Test 1", "Turhal Test 1", overlay = true, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.percent, commission_value = 0.04, slippage = 1, pyramiding = 0, calc_on_every_tick = false)
// NOT: Komisyon ve slippage, TradingView'de Ayarlar > "Özellikler (Properties)"
// sekmesinden de değiştirilebilir. strategy() içinde sabit (const) olmak zorundadır.

// ============================================================================
//  GİRDİLER
// ============================================================================
gS  = "Sinyal & Risk"
slPct = input.float(1.0, "Stop-Loss %", minval = 0.1, step = 0.1, group = gS)
tpPct = input.float(2.0, "Take-Profit %", minval = 0.1, step = 0.1, group = gS)
yon   = input.string("Her İkisi", "Yön", options = ["Her İkisi", "Sadece Long", "Sadece Short"], group = gS)

gT = "Trend Filtresi (v1.1)"
emaLen = input.int(200, "EMA Trend Periyodu", minval = 1, group = gT)

gV = "Görünüm"
showPanel = input.bool(true, "Debug Panelini Göster", group = gV)
showLines = input.bool(true, "Giriş / SL / TP Çizgilerini Göster", group = gV)

// ============================================================================
//  SİNYAL  (en basit, repaint'siz — sadece kapanmış barlar referans alınır)
//  LONG : kapanış önceki barın yükseğini aşar
//  SHORT: kapanış önceki barın düşüğünü kırar
// ============================================================================
longSig  = barstate.isconfirmed and close > high[1]
shortSig = barstate.isconfirmed and close < low[1]

// v1.1 — EMA 200 trend filtresi (yalnızca giriş kapısı; sinyalin kendisi değişmez)
ema200 = ta.ema(close, emaLen)

// ============================================================================
//  DURUM & SAYAÇLAR
// ============================================================================
allowLong  = yon != "Sadece Short"
allowShort = yon != "Sadece Long"
flat       = strategy.position_size == 0

goLong  = longSig  and flat and allowLong  and close > ema200
goShort = shortSig and flat and allowShort and close < ema200

var int nLong    = 0   // toplam LONG sinyali (koşul kaç kez gerçekleşti)
var int nShort   = 0   // toplam SHORT sinyali
var int nEntered = 0   // flat iken verilen giriş komutu sayısı
nLong    := nLong    + (longSig  ? 1 : 0)
nShort   := nShort   + (shortSig ? 1 : 0)
nEntered := nEntered + ((goLong or goShort) ? 1 : 0)

// ============================================================================
//  EMİRLER  (giriş -> pozisyon açılır -> çıkış SL/TP kurulur)
// ============================================================================
var float entryPrice = na
var float slPrice    = na
var float tpPrice    = na

// 1) GİRİŞ: yalnızca flat iken emir gönderilir (SL/TP burada hesaplanmaz;
//    çünkü gerçek dolum fiyatı sonraki bar açılışında oluşur).
if goLong
    strategy.entry("LONG", strategy.long)

if goShort
    strategy.entry("SHORT", strategy.short)

// 2) YENİ AÇILAN POZİSYONU tespit et; SL/TP'yi GERÇEK giriş fiyatından hesapla.
justLong  = strategy.position_size > 0 and strategy.position_size[1] <= 0
justShort = strategy.position_size < 0 and strategy.position_size[1] >= 0
if justLong
    entryPrice := strategy.position_avg_price
    slPrice    := entryPrice * (1 - slPct / 100)
    tpPrice    := entryPrice * (1 + tpPct / 100)
if justShort
    entryPrice := strategy.position_avg_price
    slPrice    := entryPrice * (1 + slPct / 100)
    tpPrice    := entryPrice * (1 - tpPct / 100)

// 3) ÇIKIŞ: pozisyon yönüne göre her barda SL/TP.
if strategy.position_size > 0
    strategy.exit("LONG-ÇIKIŞ", "LONG", stop = slPrice, limit = tpPrice)
if strategy.position_size < 0
    strategy.exit("SHORT-ÇIKIŞ", "SHORT", stop = slPrice, limit = tpPrice)

// ============================================================================
//  GRAFİK GÖRSELLERİ
// ============================================================================
plot(ema200, "EMA 200", color = color.new(color.orange, 0), linewidth = 2)
inPos = strategy.position_size != 0
plot(showLines and inPos ? entryPrice : na, "Giriş", color = color.new(color.gray, 0),  style = plot.style_linebr, linewidth = 1)
plot(showLines and inPos ? slPrice    : na, "SL",    color = color.new(color.red, 0),   style = plot.style_linebr, linewidth = 2)
plot(showLines and inPos ? tpPrice    : na, "TP",    color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 2)
plotshape(goLong,  "LONG Sinyali",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.small)
plotshape(goShort, "SHORT Sinyali", shape.triangledown, location.abovebar, color.new(color.red, 0),   size = size.small)

// ============================================================================
//  DEBUG PANELİ  (sayaçlar vs. Strategy Tester tutarlılığı)
//  DOĞRULAMA: "Giriş komutu" = "Açılan işlem" olmalı (her giriş 1 işlem açar).
// ============================================================================
opened = strategy.closedtrades + strategy.opentrades
tc(table tb, int c, int r, string s, color bg) => table.cell(tb, c, r, s, text_color = color.white, bgcolor = bg, text_size = size.small)

hd = color.new(color.black, 10)
kb = color.new(color.black, 25)
gap = nEntered - opened
var table dbg = table.new(position.top_right, 2, 9, border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)
if showPanel
    tc(dbg, 0, 0, "TURHAL TEST 1",       hd)
    tc(dbg, 1, 0, "v1.0",                hd)
    tc(dbg, 0, 1, "Toplam LONG sinyali", kb)
    tc(dbg, 1, 1, str.tostring(nLong),   kb)
    tc(dbg, 0, 2, "Toplam SHORT sinyali", kb)
    tc(dbg, 1, 2, str.tostring(nShort),  kb)
    tc(dbg, 0, 3, "Giriş komutu (flat)", kb)
    tc(dbg, 1, 3, str.tostring(nEntered), color.new(color.blue, 40))
    tc(dbg, 0, 4, "Açılan işlem",        kb)
    tc(dbg, 1, 4, str.tostring(opened),  color.new(nEntered == opened ? color.green : color.red, 40))
    tc(dbg, 0, 5, "Kapanan işlem",       kb)
    tc(dbg, 1, 5, str.tostring(strategy.closedtrades), kb)
    tc(dbg, 0, 6, "Açık işlem",          kb)
    tc(dbg, 1, 6, str.tostring(strategy.opentrades),   kb)
    tc(dbg, 0, 7, "Fark (komut-açılan)", kb)
    tc(dbg, 1, 7, str.tostring(gap),     color.new(gap == 0 ? color.green : color.red, 40))
    tc(dbg, 0, 8, "Öz sermaye",          kb)
    tc(dbg, 1, 8, str.tostring(strategy.equity, "0"), color.new(strategy.equity < strategy.initial_capital ? color.red : color.green, 40))
