//@version=6
// ============================================================================
//  TURHAL TEST 2  —  v1.0  (EMA 200 REJİM SİSTEMİ)
//  AMAÇ: EMA 200'ü giriş filtresi olarak değil, ana YÖN/REJİM ve pozisyon
//        değiştirme (reversal) mekanizması olarak test etmek. Kârlılık hedefi yok.
//  MANTIK: Fiyat EMA'yı yukarı keserse LONG rejim; aşağı keserse SHORT rejim.
//          Sistem her zaman piyasadadır; yalnızca ters kesişimde yön değiştirir.
//          SL/TP YOK — pozisyon yalnızca ters kesişimle kapanır.
//  Bu dosya bağımsızdır; Test 1, Lite veya diğer dosyalara dokunmaz.
//  License: MPL-2.0
// ============================================================================
strategy("Turhal Test 2", "Turhal Test 2", overlay = true, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.percent, commission_value = 0.04, slippage = 1, pyramiding = 0, calc_on_every_tick = false)
// NOT: Komisyon ve slippage, TradingView'de Ayarlar > "Özellikler (Properties)"
// sekmesinden de değiştirilebilir. strategy() içinde sabit (const) olmak zorundadır.

// ============================================================================
//  GİRDİLER
// ============================================================================
gT = "Rejim (EMA)"
emaLen = input.int(200, "EMA Rejim Periyodu", minval = 1, group = gT)

gV = "Görünüm"
showPanel = input.bool(true, "Debug Panelini Göster", group = gV)

// ============================================================================
//  REJİM SİNYALİ  (repaint'siz — kapanmış barın close'u ile kesişim)
//  ta.ema ilk bardan değer üretir; ta.crossover/crossunder tek barda tetiklenir,
//  bu yüzden "EMA üstündeyken tekrar tekrar açma" doğal olarak engellenir.
// ============================================================================
ema      = ta.ema(close, emaLen)
crossUp  = ta.crossover(close, ema)
crossDn  = ta.crossunder(close, ema)

// Guard: LONG yalnızca uzun değilken, SHORT yalnızca kısa değilken (onaylı).
goLong  = crossUp and strategy.position_size <= 0
goShort = crossDn and strategy.position_size >= 0

// ============================================================================
//  SAYAÇLAR
// ============================================================================
var int nCrossUp   = 0   // yukarı EMA kesişim sayısı
var int nCrossDn   = 0   // aşağı EMA kesişim sayısı
var int nLongCmd   = 0   // verilen LONG giriş komutu sayısı
var int nShortCmd  = 0   // verilen SHORT giriş komutu sayısı
nCrossUp  := nCrossUp  + (crossUp  ? 1 : 0)
nCrossDn  := nCrossDn  + (crossDn  ? 1 : 0)
nLongCmd  := nLongCmd  + (goLong   ? 1 : 0)
nShortCmd := nShortCmd + (goShort  ? 1 : 0)
nEntered  = nLongCmd + nShortCmd

// ============================================================================
//  EMİRLER  (reversal: pyramiding=0 iken ters yön entry mevcut pozisyonu kapatıp
//            yeni pozisyonu açar — tek çağrı, standart Pine davranışı)
// ============================================================================
if goLong
    strategy.entry("LONG", strategy.long)
if goShort
    strategy.entry("SHORT", strategy.short)

// ============================================================================
//  GRAFİK GÖRSELLERİ
// ============================================================================
plot(ema, "EMA Rejim", color = color.new(color.orange, 0), linewidth = 2)
plotshape(goLong,  "LONG Rejim",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.small, text = "LONG")
plotshape(goShort, "SHORT Rejim", shape.triangledown, location.abovebar, color.new(color.red, 0),   size = size.small, text = "SHORT")
bgcolor(color.new(strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray, 92))

// ============================================================================
//  DEBUG PANELİ
//  DOĞRULAMA (always-in-market imzası):
//   - Fark (komut - açılan) = 0  -> her komut motorda yürüdü.
//   - Açılan işlem = Yukarı + Aşağı kesişim  -> her kesişim yön değişimine döndü.
//   - Kapanan işlem = Açılan - 1  ve  Açık işlem = 1  (son pozisyon açık kalır).
//   - Strategy Tester "Total Closed Trades" = Kapanan işlem'e eşittir,
//     "Toplam komut"a DEĞİL (reversal = 1 kapanış + 1 açılış).
// ============================================================================
opened = strategy.closedtrades + strategy.opentrades
gap    = nEntered - opened
tc(table tb, int c, int r, string s, color bg) => table.cell(tb, c, r, s, text_color = color.white, bgcolor = bg, text_size = size.small)

hd = color.new(color.black, 10)
kb = color.new(color.black, 25)
var table dbg = table.new(position.top_right, 2, 11, border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)
if showPanel
    tc(dbg, 0, 0,  "TURHAL TEST 2",       hd)
    tc(dbg, 1, 0,  "v1.0",                hd)
    tc(dbg, 0, 1,  "Yukarı kesişim",      kb)
    tc(dbg, 1, 1,  str.tostring(nCrossUp), kb)
    tc(dbg, 0, 2,  "Aşağı kesişim",       kb)
    tc(dbg, 1, 2,  str.tostring(nCrossDn), kb)
    tc(dbg, 0, 3,  "LONG komut",          kb)
    tc(dbg, 1, 3,  str.tostring(nLongCmd), kb)
    tc(dbg, 0, 4,  "SHORT komut",         kb)
    tc(dbg, 1, 4,  str.tostring(nShortCmd), kb)
    tc(dbg, 0, 5,  "Toplam komut",        kb)
    tc(dbg, 1, 5,  str.tostring(nEntered), color.new(color.blue, 40))
    tc(dbg, 0, 6,  "Açılan işlem",        kb)
    tc(dbg, 1, 6,  str.tostring(opened),  color.new(opened == nCrossUp + nCrossDn ? color.green : color.red, 40))
    tc(dbg, 0, 7,  "Kapanan işlem",       kb)
    tc(dbg, 1, 7,  str.tostring(strategy.closedtrades), kb)
    tc(dbg, 0, 8,  "Açık işlem",          kb)
    tc(dbg, 1, 8,  str.tostring(strategy.opentrades),   kb)
    tc(dbg, 0, 9,  "Fark (komut-açılan)", kb)
    tc(dbg, 1, 9,  str.tostring(gap),     color.new(gap == 0 ? color.green : color.red, 40))
    tc(dbg, 0, 10, "Öz sermaye",          kb)
    tc(dbg, 1, 10, str.tostring(strategy.equity, "0"), color.new(strategy.equity < strategy.initial_capital ? color.red : color.green, 40))
