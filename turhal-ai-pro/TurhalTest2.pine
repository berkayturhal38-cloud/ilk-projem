//@version=6
// ============================================================================
//  TURHAL TEST 2  —  v1.6  (EMA200 GERÇEK GEÇİŞ + 2. ONAY + EMA500 TREND + TP/SL + USDT)
//  GİRİŞ: Fiyat EMA200'ü GERÇEKTEN keser (crossUp/crossDn = geçiş mumu, 1. onay);
//         hemen sonraki mum aynı tarafta kapanır VE trend hâlâ uygunsa 2. onay -> sinyal.
//         2. onaydan önce karşı tarafa dönerse ya da trend bozulursa setup iptal olur.
//         Trend (EMA500) setup BAŞLANGICINDA ve 2. ONAYDA kontrol edilir. Reversal korunur.
//  ÇIKIŞ: Kademeli TP (%2/%4/%6, 1/3 + 1/3 + kalan) + sabit SL %3; avg_price'tan.
//  Bu dosya bağımsızdır; Test 1, Lite veya diğer dosyalara dokunmaz.
//  License: MPL-2.0
// ============================================================================
strategy("Turhal Test 2", "Turhal Test 2", overlay = true, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.percent, commission_value = 0.04, slippage = 1, pyramiding = 0, calc_on_every_tick = false)
// NOT: Komisyon ve slippage, TradingView'de Ayarlar > "Özellikler (Properties)"
// sekmesinden de değiştirilebilir. strategy() içinde sabit (const) olmak zorundadır.

// ============================================================================
//  GİRDİLER
// ============================================================================
gT = "Rejim (EMA)"
emaLen    = input.int(200, "EMA Rejim Periyodu", minval = 1, group = gT)
ema500Len = input.int(500, "Ana Trend EMA Periyodu", minval = 1, group = gT)

gN = "Boyutlandırma"
notionalUSDT = input.float(100, "İşlem Nominal Büyüklüğü (USDT)", minval = 1, step = 10, group = gN)

gD = "Test Aralığı"
startDate = input.time(timestamp("01 Jan 2018 00:00 +0000"), "Başlangıç Tarihi", group = gD)
endDate   = input.time(timestamp("01 Jan 2100 00:00 +0000"), "Bitiş Tarihi", group = gD)

gR = "TP / SL"
slPct  = input.float(3.0, "Sabit SL %", minval = 0.1, step = 0.1, group = gR)
tp1Pct = input.float(2.0, "TP1 % (1/3)", minval = 0.1, step = 0.1, group = gR)
tp2Pct = input.float(4.0, "TP2 % (1/3)", minval = 0.1, step = 0.1, group = gR)
tp3Pct = input.float(6.0, "TP3 % (kalan)", minval = 0.1, step = 0.1, group = gR)

gV = "Görünüm"
showPanel = input.bool(true, "Debug Panelini Göster", group = gV)

// ============================================================================
//  GİRİŞ SİNYALİ  (EMA200 GERÇEK GEÇİŞ + 2. ONAY state-machine — repaint'siz)
//  1. onay = gerçek cross (crossUp/crossDn); 2. onay = hemen sonraki mum aynı tarafta
//  kapanır VE trend hâlâ uygun. Karşı tarafa dönüş veya trend bozulması -> iptal.
//  pend yalnızca test penceresinde (active) ilerler; pencere temiz (pend=0) başlar.
// ============================================================================
ema    = ta.ema(close, emaLen)
ema500 = ta.ema(close, ema500Len)
active = time >= startDate and time <= endDate

// Ana trend (EMA500) — setup başlangıcında VE 2. onayda kontrol edilir
trendUp = ema > ema500
trendDn = ema < ema500

// GERÇEK geçiş (koşulsuz hesaplanmalı; ta.* if içine alınmaz)
crossUp = ta.crossover(close, ema)   // önceki bar <= EMA200, bu bar > EMA200 (geçiş mumu = 1. onay)
crossDn = ta.crossunder(close, ema)  // önceki bar >= EMA200, bu bar < EMA200

// pend state-machine: 0 = yok, +1 = LONG 2. onay bekliyor, -1 = SHORT bekliyor
var int pend = 0
longSetup   = false
shortSetup  = false
trendCancel = false   // 2. onayda close doğru tarafta AMA trend bozuldu -> iptal (teşhis)
if active
    // 1) bekleyen 2. onayı bu barın kapanışı + trend YENİDEN kontrol ile değerlendir
    if pend == 1
        if close > ema and trendUp
            longSetup := true
        else if close > ema
            trendCancel := true
        pend := 0
    else if pend == -1
        if close < ema and trendDn
            shortSetup := true
        else if close < ema
            trendCancel := true
        pend := 0
    // 2) yeni setup başlangıcı: gerçek geçiş + uygun trend (aksi halde setup kurulmaz)
    if crossUp and trendUp
        pend := 1
    else if crossDn and trendDn
        pend := -1
else
    pend := 0

// Pozisyon guard'ları korunur (trend zaten longSetup/shortSetup içinde doğrulandı)
goLong  = active and longSetup  and strategy.position_size <= 0
goShort = active and shortSetup and strategy.position_size >= 0

// Sabit ~USDT nominal boyut: qty = notional / fiyat (öz sermayeye bağlı DEĞİL, compounding YOK)
qtyCalc = notionalUSDT / close

if goLong
    strategy.entry("LONG", strategy.long, qty = qtyCalc)
else if goShort
    strategy.entry("SHORT", strategy.short, qty = qtyCalc)

// ============================================================================
//  TP / SL ÇIKIŞLARI  (v1.2'den korunuyor — gerçek dolumda BİR KEZ, avg_price'tan)
//  TP1/TP2 birer 1/3 (mutlak qty), TP3 kalan; üçünde de aynı sabit SL. BE/trailing yok.
//  Reversal'da eski yön çıkışları from_entry kopunca iptal olur; yeni yön burada kurulur.
// ============================================================================
var float entryNom = na   // GİRİŞ anındaki gerçekleşen nominal (USDT); TP1/TP2 sonrası DEĞİŞMEZ
justLong  = strategy.position_size > 0 and strategy.position_size[1] <= 0
justShort = strategy.position_size < 0 and strategy.position_size[1] >= 0
if justLong
    e     = strategy.position_avg_price
    third = strategy.position_size / 3.0
    entryNom := math.abs(strategy.position_size) * e
    strategy.exit("L-TP1", "LONG", qty = third, stop = e * (1 - slPct / 100), limit = e * (1 + tp1Pct / 100))
    strategy.exit("L-TP2", "LONG", qty = third, stop = e * (1 - slPct / 100), limit = e * (1 + tp2Pct / 100))
    strategy.exit("L-TP3", "LONG",              stop = e * (1 - slPct / 100), limit = e * (1 + tp3Pct / 100))
if justShort
    e     = strategy.position_avg_price
    third = -strategy.position_size / 3.0
    entryNom := math.abs(strategy.position_size) * e
    strategy.exit("S-TP1", "SHORT", qty = third, stop = e * (1 + slPct / 100), limit = e * (1 - tp1Pct / 100))
    strategy.exit("S-TP2", "SHORT", qty = third, stop = e * (1 + slPct / 100), limit = e * (1 - tp2Pct / 100))
    strategy.exit("S-TP3", "SHORT",              stop = e * (1 + slPct / 100), limit = e * (1 - tp3Pct / 100))

// ============================================================================
//  SAYAÇLAR
// ============================================================================
var int nLongCmd  = 0
var int nShortCmd = 0
var int nOpen       = 0   // GERÇEK yeni pozisyon/yön açılışı (justLong or justShort)
var int nTrendBlock = 0   // trend teşhisi: (a) trend yüzünden BAŞLAMAYAN gerçek cross +
                          //                (b) 2. onayda trend bozulup İPTAL edilen setup.
// (a) ve (b) aynı barda birlikte oluşamaz (biri cross barı, diğeri pend-çözüm barı) -> çift sayım YOK
startBlock = active and ((crossUp and not trendUp) or (crossDn and not trendDn))
nLongCmd    := nLongCmd    + (goLong  ? 1 : 0)
nShortCmd   := nShortCmd   + (goShort ? 1 : 0)
nOpen       := nOpen       + ((justLong or justShort) ? 1 : 0)
nTrendBlock := nTrendBlock + ((startBlock or trendCancel) ? 1 : 0)
nEntered    = nLongCmd + nShortCmd

// ============================================================================
//  GRAFİK GÖRSELLERİ
// ============================================================================
plot(ema, "EMA 200 Rejim", color = color.new(color.orange, 0), linewidth = 2)
plot(ema500, "EMA 500 Trend", color = color.new(color.blue, 0), linewidth = 2)
plotshape(goLong,  "LONG",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.small, text = "LONG")
plotshape(goShort, "SHORT", shape.triangledown, location.abovebar, color.new(color.red, 0),   size = size.small, text = "SHORT")
bgcolor(color.new(strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray, 92))

// ============================================================================
//  DEBUG PANELİ  (motor doğrulaması yeni giriş mimarisine uyarlandı)
//   - Fark2 = Toplam komut - Yeni açılış = 0 (son barda bekleyen emir varsa 1).
//   - "Yeni açılış" justLong/justShort ile gerçek pozisyon/yön açılışını sayar.
//   - "Kapanan (parçalı)" her TP dilimini AYRI sayar; komut sayısına eşit BEKLENMEZ.
//   - "Bekleyen onay" = 2. onay beklenen yön (pend) — state-machine teşhisi.
// ============================================================================
gap2   = nEntered - nOpen
posTxt = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
pendTxt = pend == 1 ? "LONG bekliyor" : pend == -1 ? "SHORT bekliyor" : "-"
nomTxt = na(entryNom) ? "-" : str.tostring(entryNom, "0.0")
tc(table tb, int c, int r, string s, color bg) => table.cell(tb, c, r, s, text_color = color.white, bgcolor = bg, text_size = size.small)

hd = color.new(color.black, 10)
kb = color.new(color.black, 25)
var table dbg = table.new(position.top_right, 2, 14, border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)
if showPanel
    tc(dbg, 0, 0,  "TURHAL TEST 2",       hd)
    tc(dbg, 1, 0,  "v1.6",                hd)
    tc(dbg, 0, 1,  "EMA periyodu",        kb)
    tc(dbg, 1, 1,  str.tostring(emaLen),  kb)
    tc(dbg, 0, 2,  "Bekleyen onay",       kb)
    tc(dbg, 1, 2,  pendTxt,               kb)
    tc(dbg, 0, 3,  "LONG komut",          kb)
    tc(dbg, 1, 3,  str.tostring(nLongCmd), kb)
    tc(dbg, 0, 4,  "SHORT komut",         kb)
    tc(dbg, 1, 4,  str.tostring(nShortCmd), kb)
    tc(dbg, 0, 5,  "Toplam komut",        kb)
    tc(dbg, 1, 5,  str.tostring(nEntered), color.new(color.blue, 40))
    tc(dbg, 0, 6,  "Yeni açılış (justL/S)", kb)
    tc(dbg, 1, 6,  str.tostring(nOpen),   color.new(color.blue, 40))
    tc(dbg, 0, 7,  "Fark2 (komut-açılış)", kb)
    tc(dbg, 1, 7,  str.tostring(gap2),    color.new(gap2 == 0 or gap2 == 1 ? color.green : color.red, 40))
    tc(dbg, 0, 8,  "Kapanan (parçalı)",   kb)
    tc(dbg, 1, 8,  str.tostring(strategy.closedtrades), kb)
    tc(dbg, 0, 9,  "Açık işlem",          kb)
    tc(dbg, 1, 9,  str.tostring(strategy.opentrades),   kb)
    tc(dbg, 0, 10, "Durum",               kb)
    tc(dbg, 1, 10, posTxt,                kb)
    tc(dbg, 0, 11, "Giriş nominali $",    kb)
    tc(dbg, 1, 11, nomTxt,                color.new(color.blue, 40))
    tc(dbg, 0, 12, "Trend engeli",        kb)
    tc(dbg, 1, 12, str.tostring(nTrendBlock), color.new(color.blue, 40))
    tc(dbg, 0, 13, "Öz sermaye",          kb)
    tc(dbg, 1, 13, str.tostring(strategy.equity, "0"), color.new(strategy.equity < strategy.initial_capital ? color.red : color.green, 40))
