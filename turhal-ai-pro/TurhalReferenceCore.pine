//@version=6
// ============================================================================
//  TURHAL REFERENCE CORE  —  v1  (M1: Skorlu Trend Çizgisi + Paralel Kanal)
//  AMAÇ: Referans sistemin grafik omurgasındaki TL/kanal DAVRANIŞINI bağımsız
//  bir Pine implementasyonuyla yeniden kurmak (satır satır kopya DEĞİL).
//  KAPSAM (yalnızca M1):
//   - 2 katman: Ana (pivot len 20) + Ara (pivot len 10); katman başına son 8 pivot
//   - Tüm uygun pivot çiftlerinden aday çizgi; her aday geçmişte bar bar test edilir
//   - Temas: 0.5xATR bölge, temaslar arası >= 5 bar; İhlal: close tabanlı, toleranssız
//   - maxViol üstü aday elenir; güncel barda close çizgiyi 0.5xATR aşmışsa aday elenir
//   - Skor = temas*10 - ihlal*3 + uzunluk/100; en yüksek skorlu Up/Dn çizgi seçilir
//   - Paralel kanal: TL boyunca karşı ekstrem max sapma = offset; >= 2 karşı temas
//     şartı; orta çizgi = offset/2
//   - Kırılım: 2 ardışık close ihlali (0.5xATR marj) VEYA 1.0xATR wick big-break
//     VEYA 1.5xATR far-break; kırılan çizgi 15 bar KESİKLİ archive olarak kalır
//   - Recompute YALNIZCA yeni onaylı pivot geldiğinde; tüm state isconfirmed'de
//  YOK: S/R, EMA/KAMA, Fib, FVG, panel, sinyal, strategy, LONG/SHORT, risk.
//  NON-REPAINT: pivotlar len bar sağ-onay gecikmeli; geçmiş OHLC kendi
//  buffer'ımızdan okunur (yalnızca kapanmış barlar); future leak yok.
//  License: MPL-2.0
// ============================================================================
indicator("Turhal Reference Core v1", "Turhal RefCore", overlay = true, max_lines_count = 60, max_labels_count = 20)

// ============================================================================
//  GİRDİLER
// ============================================================================
gM = "M1 — Trend Çizgisi Motoru"
lenMain     = input.int(20, "Ana Katman Pivot Uzunluğu", minval = 5, maxval = 50, group = gM)
useMid      = input.bool(true, "Ara Katman Aktif", group = gM)
lenMid      = input.int(10, "Ara Katman Pivot Uzunluğu", minval = 3, maxval = 30, group = gM)
atrLen      = input.int(14, "ATR Periyodu", minval = 1, group = gM)
maxViol     = input.int(1, "Maks İhlal (aday eleme)", minval = 0, maxval = 3, group = gM)
tzK         = input.float(0.5, "Temas Bölgesi (xATR)", minval = 0.1, step = 0.1, group = gM)
minGap      = input.int(5, "Temaslar Arası Min Bar", minval = 2, maxval = 20, group = gM)
chTouchK    = input.float(1.0, "Kanal Temas Bölgesi (xATR)", minval = 0.1, step = 0.1, group = gM)
chMinTouch  = input.int(2, "Kanal İçin Min Karşı Temas", minval = 2, maxval = 5, group = gM)
wickK       = input.float(1.0, "Big-Break Wick (xATR)", minval = 0.1, step = 0.1, group = gM)
farK        = input.float(1.5, "Far-Break Wick (xATR)", minval = 0.1, step = 0.1, group = gM)
archiveBars = input.int(15, "Kırık Çizgi Archive Süresi (bar)", minval = 1, maxval = 30, group = gM)
rearmBars   = input.int(3, "Kırılım Sonrası Yeni Aday Bekleme (bar)", minval = 0, maxval = 10, group = gM)

gV = "Görünüm"
showChannel = input.bool(true, "Paralel Kanal + Orta Çizgi", group = gV)
showArchive = input.bool(true, "Kırık Çizgi Archive (kesikli)", group = gV)
showLabels  = input.bool(true, "Ana Katman Etiketi (temas + skor)", group = gV)
colUp       = input.color(color.new(color.lime, 0), "Up TL Rengi", group = gV)
colDn       = input.color(color.new(color.red, 0),  "Down TL Rengi", group = gV)

// ============================================================================
//  ORTAK VERİ  (kapalı-bar OHLC buffer'ı: aday taramaları BURADAN okur)
// ============================================================================
atr = ta.atr(atrLen)
phM = ta.pivothigh(lenMain, lenMain)
plM = ta.pivotlow(lenMain, lenMain)
phI = ta.pivothigh(lenMid, lenMid)
plI = ta.pivotlow(lenMid, lenMid)

var float[] bLo = array.new_float()
var float[] bHi = array.new_float()
var float[] bC  = array.new_float()

// buffer index: son eleman = şu anki onaylı bar (bar_index). Kesintisiz seri.
f_at(float[] a, int x) =>
    i = array.size(a) - 1 - (bar_index - x)
    i >= 0 and i < array.size(a) ? array.get(a, i) : na

// ============================================================================
//  PİVOT HAVUZLARI  (katman başına son 8 onaylı pivot; en yeni SONDA)
// ============================================================================
var float[] pvLoM = array.new_float()
var int[]   pxLoM = array.new_int()
var float[] pvHiM = array.new_float()
var int[]   pxHiM = array.new_int()
var float[] pvLoI = array.new_float()
var int[]   pxLoI = array.new_int()
var float[] pvHiI = array.new_float()
var int[]   pxHiI = array.new_int()

f_pushPv(float[] pv, int[] px, float v, int x) =>
    array.push(pv, v)
    array.push(px, x)
    if array.size(pv) > 8
        array.shift(pv)
        array.shift(px)

// ============================================================================
//  SLOT STATE  (4 slot: 0=AnaUp, 1=AnaDn, 2=AraUp, 3=AraDn)
// ============================================================================
var float[] slSlope = array.new_float(4, na)
var float[] slBase  = array.new_float(4, na)
var int[]   slX     = array.new_int(4, 0)
var bool[]  slValid = array.new_bool(4, false)
var bool[]  slBrk   = array.new_bool(4, false)
var int[]   slBrkBar = array.new_int(4, 0)
var int[]   slBrkCnt = array.new_int(4, 0)
var int[]   slTouch = array.new_int(4, 0)
var float[] slScore = array.new_float(4, 0.0)
var float[] chOff   = array.new_float(4, 0.0)
var bool[]  chValid = array.new_bool(4, false)
// Archive (kırılan çizgi archiveBars boyunca kesikli kalır)
var float[] arSlope = array.new_float(4, na)
var float[] arBase  = array.new_float(4, na)
var int[]   arX     = array.new_int(4, 0)
var int[]   arBrkBar = array.new_int(4, 0)
var bool[]  arActive = array.new_bool(4, false)

// ============================================================================
//  ADAY TARAMA  (tek çift: geçmişi bar bar test et — temas / ihlal / güncel bar)
// ============================================================================
f_scanPair(float v2, int x2, float v1, int x1, bool isUp, float tz) =>
    float slope = (v1 - v2) / (x1 - x2)
    int span = bar_index - x2
    int viol = 0
    int touch = 0
    int lastT = -999
    bool ok = span > 0 and span <= 600
    if ok
        for b = 1 to span
            if ok
                lv = v2 + slope * b
                pe = isUp ? f_at(bLo, x2 + b) : f_at(bHi, x2 + b)
                cv = f_at(bC, x2 + b)
                if not na(pe) and math.abs(pe - lv) < tz and (b - lastT) >= minGap
                    touch += 1
                    lastT := b
                // İhlal: close tabanlı, TOLERANSSIZ ("trendi kıran bar close olmamalı")
                if not na(cv) and ((isUp and cv < lv) or (not isUp and cv > lv))
                    viol += 1
                    if viol > maxViol
                        ok := false
    if ok
        // Güncel bar geçerlilik filtresi
        curV = v2 + slope * span
        if (isUp and close < curV - tz) or (not isUp and close > curV + tz)
            ok := false
    float sc = touch * 10.0 - viol * 3.0 + span / 100.0
    [ok, slope, sc, touch]

//  EN İYİ ADAY: havuzdaki tüm uygun çiftler taranır, en yüksek skor kazanır
f_best(float[] pv, int[] px, bool isUp) =>
    float bSlope = na
    float bBase = na
    int   bX = 0
    bool  found = false
    int   bTouch = 0
    float bScore = -1e18
    float tz = tzK * atr
    int n = array.size(pv)
    if n >= 2 and not na(atr) and atr > 0
        for i = 0 to n - 2                     // i = ESKİ pivot
            v2 = array.get(pv, i)
            x2 = array.get(px, i)
            for j = i + 1 to n - 1             // j = YENİ pivot
                v1 = array.get(pv, j)
                x1 = array.get(px, j)
                okDir = isUp ? v1 > v2 : v1 < v2   // Up: dipler yükselir, Dn: tepeler düşer
                if x1 > x2 and okDir
                    [ok, slp, sc, tch] = f_scanPair(v2, x2, v1, x1, isUp, tz)
                    if ok and sc > bScore
                        bScore := sc
                        bSlope := slp
                        bBase := v2
                        bX := x2
                        found := true
                        bTouch := tch
    [found, bSlope, bBase, bX, bTouch, bScore]

// ============================================================================
//  PARALEL KANAL  (karşı ekstremin max sapması = offset; >= chMinTouch temas)
// ============================================================================
f_channel(float slope, float base, int x2, bool isUp) =>
    int span = bar_index - x2
    float ext = 0.0
    if span > 0 and span <= 600
        for b = 0 to span
            lv = base + slope * b
            pe = isUp ? f_at(bHi, x2 + b) : f_at(bLo, x2 + b)
            if not na(pe)
                d = isUp ? pe - lv : lv - pe
                if d > ext
                    ext := d
    int tch = 0
    int lastZ = -999
    if ext > 0 and span > 0 and span <= 600
        for b = 0 to span
            cl = base + slope * b + (isUp ? ext : -ext)
            pe = isUp ? f_at(bHi, x2 + b) : f_at(bLo, x2 + b)
            if not na(pe) and math.abs(pe - cl) < atr * chTouchK and (b - lastZ) >= minGap
                tch += 1
                lastZ := b
    [isUp ? ext : -ext, tch >= chMinTouch]

// ============================================================================
//  SLOT GÜNCELLEME  (yalnızca yeni onaylı pivotta çağrılır)
// ============================================================================
f_slotUpdate(int s, bool isUp, float[] pv, int[] px) =>
    [found, slp, bse, x2v, tch, sc] = f_best(pv, px, isUp)
    canFill = not array.get(slBrk, s) or (bar_index - array.get(slBrkBar, s)) >= rearmBars
    if found and canFill
        // Kırık ama hâlâ görünür çizgi varsa archive'e taşı
        if array.get(slValid, s) and array.get(slBrk, s)
            array.set(arSlope, s, array.get(slSlope, s))
            array.set(arBase, s, array.get(slBase, s))
            array.set(arX, s, array.get(slX, s))
            array.set(arBrkBar, s, array.get(slBrkBar, s))
            array.set(arActive, s, true)
        array.set(slSlope, s, slp)
        array.set(slBase, s, bse)
        array.set(slX, s, x2v)
        array.set(slValid, s, true)
        array.set(slBrk, s, false)
        array.set(slBrkCnt, s, 0)
        array.set(slTouch, s, tch)
        array.set(slScore, s, sc)
        [off, okc] = f_channel(slp, bse, x2v, isUp)
        array.set(chOff, s, off)
        array.set(chValid, s, okc)

// ============================================================================
//  MOTOR  (yalnızca KAPANMIŞ barda: buffer + pivot + recompute + kırılım izleme)
// ============================================================================
if barstate.isconfirmed
    array.push(bLo, low)
    array.push(bHi, high)
    array.push(bC, close)
    if array.size(bC) > 800
        array.shift(bLo)
        array.shift(bHi)
        array.shift(bC)

    // Yeni onaylı pivot -> havuza ekle + SADECE ilgili slotu yeniden hesapla
    if not na(plM)
        f_pushPv(pvLoM, pxLoM, plM, bar_index - lenMain)
        f_slotUpdate(0, true, pvLoM, pxLoM)
    if not na(phM)
        f_pushPv(pvHiM, pxHiM, phM, bar_index - lenMain)
        f_slotUpdate(1, false, pvHiM, pxHiM)
    if useMid and not na(plI)
        f_pushPv(pvLoI, pxLoI, plI, bar_index - lenMid)
        f_slotUpdate(2, true, pvLoI, pxLoI)
    if useMid and not na(phI)
        f_pushPv(pvHiI, pxHiI, phI, bar_index - lenMid)
        f_slotUpdate(3, false, pvHiI, pxHiI)

    // Kırılım izleme (tüm slotlar, her kapanmış barda)
    if not na(atr)
        for s = 0 to 3
            if array.get(slValid, s)
                isUp = s % 2 == 0
                nowV = array.get(slBase, s) + array.get(slSlope, s) * (bar_index - array.get(slX, s))
                if not array.get(slBrk, s)
                    thr = 0.5 * atr
                    violated = isUp ? close < nowV - thr : close > nowV + thr
                    array.set(slBrkCnt, s, violated ? array.get(slBrkCnt, s) + 1 : 0)
                    bigB = isUp ? low < nowV - atr * wickK : high > nowV + atr * wickK
                    farB = isUp ? low < nowV - atr * farK  : high > nowV + atr * farK
                    if array.get(slBrkCnt, s) >= 2 or bigB or farB
                        array.set(slBrk, s, true)
                        array.set(slBrkBar, s, bar_index)
                else
                    if bar_index - array.get(slBrkBar, s) > archiveBars
                        array.set(slValid, s, false)
                // Kanal kırılımı (karşı bant close ile aşılırsa kanal düşer)
                if array.get(chValid, s) and not array.get(slBrk, s)
                    chNow = nowV + array.get(chOff, s)
                    if (isUp and close > chNow + 0.5 * atr) or (not isUp and close < chNow - 0.5 * atr)
                        array.set(chValid, s, false)
            if array.get(arActive, s) and bar_index - array.get(arBrkBar, s) > archiveBars
                array.set(arActive, s, false)

// ============================================================================
//  ÇİZİM  (islast: sil + yeniden çiz; birikme yok)
// ============================================================================
var line[]  dLn = array.new_line()
var label[] dLb = array.new_label()
if barstate.islast
    for ln in dLn
        line.delete(ln)
    for lb in dLb
        label.delete(lb)
    array.clear(dLn)
    array.clear(dLb)
    xR = bar_index + 20
    for s = 0 to 3
        layerOn = s < 2 or useMid
        isUp = s % 2 == 0
        col = isUp ? colUp : colDn
        // Archive: kırılan eski çizgi (kesikli, soluk)
        if showArchive and layerOn and array.get(arActive, s)
            aX = math.max(array.get(arX, s), bar_index - 500)
            aY1 = array.get(arBase, s) + array.get(arSlope, s) * (aX - array.get(arX, s))
            aY2 = array.get(arBase, s) + array.get(arSlope, s) * (xR - array.get(arX, s))
            array.push(dLn, line.new(aX, aY1, xR, aY2, color = color.new(col, 70), style = line.style_dotted, width = 1))
        if layerOn and array.get(slValid, s)
            x0  = array.get(slX, s)
            x1d = math.max(x0, bar_index - 500)
            slp = array.get(slSlope, s)
            bse = array.get(slBase, s)
            y1 = bse + slp * (x1d - x0)
            y2 = bse + slp * (xR - x0)
            brk = array.get(slBrk, s)
            tch = array.get(slTouch, s)
            wd  = tch >= 5 ? 3 : tch >= 3 ? 2 : 1
            tr  = brk ? 70 : s >= 2 ? 45 : 10
            sty = brk ? line.style_dotted : line.style_solid
            array.push(dLn, line.new(x1d, y1, xR, y2, color = color.new(col, tr), style = sty, width = wd))
            if showLabels and s < 2
                ltxt = (isUp ? "▲ Ana Up" : "▼ Ana Dn") + (brk ? " KIRIK" : "") + "  " + str.tostring(tch) + "t  skor " + str.tostring(array.get(slScore, s), "0.0")
                array.push(dLb, label.new(xR, y2, ltxt, color = color.new(col, 60), textcolor = color.white, size = size.tiny, style = label.style_label_left))
            if showChannel and array.get(chValid, s) and not brk
                off = array.get(chOff, s)
                array.push(dLn, line.new(x1d, y1 + off, xR, y2 + off, color = color.new(col, s >= 2 ? 55 : 25), style = line.style_solid, width = 1))
                array.push(dLn, line.new(x1d, y1 + off / 2, xR, y2 + off / 2, color = color.new(col, 65), style = line.style_dashed, width = 1))
