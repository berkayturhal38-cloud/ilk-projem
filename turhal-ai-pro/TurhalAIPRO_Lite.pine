//@version=6
// ============================================================================
//  Turhal AI PRO — Lite   (flat / mobile-safe: no if/for/blocks)
//  Non-repaint lock engine · momentum bias · WAIT reasons.
//  SHADOW MODE: independent analytics layer that virtually takes the trades
//  the real engine skips while in WAIT, locks a virtual plan on the confirmed
//  bar, tracks the outcome on later bars only (no lookahead / no repaint),
//  marks same-bar SL+TP as AMBIGUOUS, and keeps per-blocker win/total stats.
//  It NEVER touches the real signals, entry engine or confidence.
//  Author: berkayturhal38 | License: MPL-2.0
// ============================================================================
indicator("Turhal AI PRO — Lite", "Turhal AI PRO Lite", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ---- INPUTS -----------------------------------------------------------------
gS = "Structure"
swingLen   = input.int(10, "Swing Length", minval = 2, maxval = 100, group = gS)
showSwings = input.bool(true, "Show Swing HH/LL", group = gS)
showBreaks = input.bool(true, "Show BOS / CHoCH", group = gS)

gF = "Filters"
useATR  = input.bool(true, "ATR Strong-Break Filter", group = gF)
atrLen  = input.int(14, "ATR Length", minval = 1, group = gF)
atrMult = input.float(0.7, "Min Body / ATR", minval = 0.0, step = 0.1, group = gF)
useVol  = input.bool(true, "Volume Filter", group = gF)
volLen  = input.int(20, "Volume MA Length", minval = 1, group = gF)
volMult = input.float(1.2, "Min Volume / MA", minval = 0.0, step = 0.1, group = gF)

gM = "Multi-Timeframe"
mtfFilter = input.bool(true, "Require MTF bias alignment", group = gM)
htfTf1    = input.timeframe("60",  "Higher Timeframe 1", group = gM)
htfTf2    = input.timeframe("240", "Higher Timeframe 2", group = gM)
emaLen    = input.int(50, "HTF EMA Length", minval = 1, group = gM)

gMo = "Momentum Bias"
emaFastLen = input.int(21, "EMA Fast", minval = 1, group = gMo)
emaSlowLen = input.int(55, "EMA Slow", minval = 1, group = gMo)

gPD = "Premium / Discount"
showPD = input.bool(true, "Show Premium/Discount zone", group = gPD)

gE = "Entry Engine"
showEntry      = input.bool(true, "Show Entry Arrows", group = gE)
entryThreshold = input.int(70, "Min Confidence (%)", minval = 0, maxval = 100, group = gE)
needDiscount   = input.bool(true, "Longs in Discount / Shorts in Premium", group = gE)
slAtrMult      = input.float(1.0, "SL ATR Buffer", minval = 0.0, step = 0.1, group = gE)
rr1 = input.float(1.0, "TP1 (R)", minval = 0.1, step = 0.1, group = gE)
rr2 = input.float(2.0, "TP2 (R)", minval = 0.1, step = 0.1, group = gE)
rr3 = input.float(3.0, "TP3 (R)", minval = 0.1, step = 0.1, group = gE)

gSh = "Shadow Mode (missed-trade analytics)"
shadowOn   = input.bool(true, "Enable Shadow Mode", group = gSh)
showShadow = input.bool(true, "Show Shadow Panel", group = gSh)

gC = "Colors"
bullCol  = input.color(#26a69a, "Bullish", group = gC)
bearCol  = input.color(#ef5350, "Bearish", group = gC)
swingCol = input.color(#787b86, "Swing", group = gC)
premCol  = input.color(#ef5350, "Premium", group = gC)
discCol  = input.color(#26a69a, "Discount", group = gC)

// ---- SINGLE-LINE HELPERS ----------------------------------------------------
f_trTxt(int t) => t == 1 ? "BULLISH" : t == -1 ? "BEARISH" : "NEUTRAL"
f_trCol(int t) => t == 1 ? bullCol : t == -1 ? bearCol : color.gray
f_biasTxt(bool b) => b ? "BULLISH" : "BEARISH"
f_biasCol(bool b) => b ? bullCol : bearCol
f_px(float v) => na(v) ? "-" : str.tostring(v, format.mintick)
f_sh(string s) => showShadow ? s : ""

// ---- 1) FILTERS (ATR / Volume) ---------------------------------------------
atrVal   = ta.atr(atrLen)
bodySize = math.abs(close - open)
volMA    = ta.sma(volume, volLen)
atrOK    = not useATR or (not na(atrVal) and bodySize >= atrVal * atrMult)
volOK    = not useVol or na(volume) or (not na(volMA) and volume >= volMA * volMult)
strong   = atrOK and volOK

// ---- 2) MULTI-TIMEFRAME BIAS (non-repaint: lookahead_off) -------------------
htf1Bull = request.security(syminfo.tickerid, htfTf1, close > ta.ema(close, emaLen), lookahead = barmerge.lookahead_off)
htf2Bull = request.security(syminfo.tickerid, htfTf2, close > ta.ema(close, emaLen), lookahead = barmerge.lookahead_off)
bullMTFok = not mtfFilter or (htf1Bull and htf2Bull)
bearMTFok = not mtfFilter or (not htf1Bull and not htf2Bull)

// ---- MOMENTUM BIAS (5-level; reacts to price; separate from structure) ------
emaF = ta.ema(close, emaFastLen)
emaS = ta.ema(close, emaSlowLen)
bScore = (close > emaF ? 1 : -1) + (emaF > emaS ? 1 : -1) + (htf1Bull ? 1 : -1) + (htf2Bull ? 1 : -1)
biasTxt = bScore >= 3 ? "STRONG BULL" : bScore >= 1 ? "BULLISH" : bScore <= -3 ? "STRONG BEAR" : bScore <= -1 ? "BEARISH" : "NEUTRAL"
biasCol = bScore >= 3 ? bullCol : bScore >= 1 ? color.new(bullCol, 35) : bScore <= -3 ? bearCol : bScore <= -1 ? color.new(bearCol, 35) : color.gray

// ---- 3) SWINGS (confirmed pivots; markers drawn back with offset) -----------
ph = ta.pivothigh(swingLen, swingLen)
pl = ta.pivotlow(swingLen, swingLen)
var float lastPH = na
var int   lastPHx = na
var float lastPL = na
var int   lastPLx = na
lastPH  := na(ph) ? lastPH : ph
lastPHx := na(ph) ? lastPHx : bar_index - swingLen
lastPL  := na(pl) ? lastPL : pl
lastPLx := na(pl) ? lastPLx : bar_index - swingLen

plotshape(showSwings and not na(ph), title = "Swing High", style = shape.triangledown, location = location.abovebar, color = swingCol, offset = -swingLen, size = size.tiny)
plotshape(showSwings and not na(pl), title = "Swing Low",  style = shape.triangleup,   location = location.belowbar, color = swingCol, offset = -swingLen, size = size.tiny)

// ---- 4) MARKET STRUCTURE: BOS / CHoCH (confirmed-only state machine) --------
var float upLevel = na
var bool  upBroken = false
var float dnLevel = na
var bool  dnBroken = false
var int   trend = 0
upLevel  := na(ph) ? upLevel : ph
upBroken := na(ph) ? upBroken : false
dnLevel  := na(pl) ? dnLevel : pl
dnBroken := na(pl) ? dnBroken : false

bullBreak = not na(upLevel) and not upBroken and barstate.isconfirmed and close > upLevel and strong and bullMTFok
bearBreak = not na(dnLevel) and not dnBroken and barstate.isconfirmed and close < dnLevel and strong and bearMTFok
isChochUp = bullBreak and trend == -1
isChochDn = bearBreak and trend == 1
upBroken := bullBreak ? true : upBroken
dnBroken := bearBreak ? true : dnBroken
trend    := bullBreak ? 1 : bearBreak ? -1 : trend

plotshape(showBreaks and bullBreak and not isChochUp, title = "BOS Up",   style = shape.triangleup,   location = location.belowbar, color = bullCol,     text = "BOS",   textcolor = color.white, size = size.tiny)
plotshape(showBreaks and bearBreak and not isChochDn, title = "BOS Down", style = shape.triangledown, location = location.abovebar, color = bearCol,     text = "BOS",   textcolor = color.white, size = size.tiny)
plotshape(showBreaks and isChochUp, title = "CHoCH Up",   style = shape.diamond, location = location.belowbar, color = color.yellow, text = "CHoCH", textcolor = color.white, size = size.tiny)
plotshape(showBreaks and isChochDn, title = "CHoCH Down", style = shape.diamond, location = location.abovebar, color = color.yellow, text = "CHoCH", textcolor = color.white, size = size.tiny)

// ---- 5) PREMIUM / DISCOUNT --------------------------------------------------
pdEq = (not na(lastPH) and not na(lastPL)) ? (lastPH + lastPL) / 2 : na
inDiscount = not na(pdEq) and close < pdEq
inPremium  = not na(pdEq) and close > pdEq
pHi = plot(showPD ? lastPH : na, "Range High", color = color.new(premCol, 55), style = plot.style_linebr)
pEq = plot(showPD ? pdEq   : na, "Equilibrium", color = color.new(color.gray, 30), style = plot.style_linebr)
pLo = plot(showPD ? lastPL : na, "Range Low", color = color.new(discCol, 55), style = plot.style_linebr)
fill(pHi, pEq, color = color.new(premCol, 90), title = "Premium")
fill(pEq, pLo, color = color.new(discCol, 90), title = "Discount")

// ---- 6) SINGLE CONFIDENCE (0-100) — feeds BOTH Signal and Setup ------------
al1    = trend == 1 ? htf1Bull : trend == -1 ? not htf1Bull : false
al2    = trend == 1 ? htf2Bull : trend == -1 ? not htf2Bull : false
zoneOK = trend == 1 ? inDiscount : trend == -1 ? inPremium : false
cMTF   = (al1 ? 20.0 : 0.0) + (al2 ? 25.0 : 0.0)
cDisp  = (not na(atrVal) and atrVal > 0) ? math.min(25.0, bodySize / atrVal * 17.0) : 0.0
cVol   = (not na(volume) and not na(volMA) and volMA > 0) ? math.min(15.0, volume / volMA * 8.0) : 0.0
cZone  = zoneOK ? 15.0 : 0.0
conf   = trend == 0 ? 0 : int(math.min(100, math.round(cMTF + cDisp + cVol + cZone)))

// ---- 7) LIVE PLAN CANDIDATE (used to LOCK on a signal / shadow) -------------
planEntry = trend == 0 ? na : close
planSL = trend == 1 ? ((na(lastPL) ? low : math.min(lastPL, low)) - (na(atrVal) ? 0.0 : atrVal * slAtrMult)) : trend == -1 ? ((na(lastPH) ? high : math.max(lastPH, high)) + (na(atrVal) ? 0.0 : atrVal * slAtrMult)) : na
planRisk = trend == 1 ? (planEntry - planSL) : trend == -1 ? (planSL - planEntry) : na
validPlan = not na(planRisk) and planRisk > 0
planTP1 = not validPlan ? na : trend == 1 ? planEntry + planRisk * rr1 : planEntry - planRisk * rr1
planTP2 = not validPlan ? na : trend == 1 ? planEntry + planRisk * rr2 : planEntry - planRisk * rr2
planTP3 = not validPlan ? na : trend == 1 ? planEntry + planRisk * rr3 : planEntry - planRisk * rr3

// ---- 8) SETUP CONDITIONS + ARROWS (fire only on a fresh confirmed break) ----
longSig  = showEntry and bullBreak and (not needDiscount or inDiscount) and conf >= entryThreshold and validPlan
shortSig = showEntry and bearBreak and (not needDiscount or inPremium)  and conf >= entryThreshold and validPlan
plotshape(longSig,  title = "LONG",  style = shape.labelup,   location = location.belowbar, color = bullCol, text = "LONG",  textcolor = color.white, size = size.small)
plotshape(shortSig, title = "SHORT", style = shape.labeldown, location = location.abovebar, color = bearCol, text = "SHORT", textcolor = color.white, size = size.small)

// ---- 9) LOCK / CANCEL REAL SETUP (values freeze until new setup / cancel) ---
var int   sDir = 0
var float sEntry = na
var float sSL = na
var float sTP1 = na
var float sTP2 = na
var float sTP3 = na
cancelLong  = sDir == 1  and (low  <= sSL or high >= sTP3 or bearBreak)
cancelShort = sDir == -1 and (high >= sSL or low  <= sTP3 or bullBreak)
cleared = cancelLong or cancelShort
sDir   := longSig ? 1 : shortSig ? -1 : cleared ? 0 : sDir
sEntry := longSig ? planEntry : shortSig ? planEntry : cleared ? na : sEntry
sSL    := longSig ? planSL : shortSig ? planSL : cleared ? na : sSL
sTP1   := longSig ? planTP1 : shortSig ? planTP1 : cleared ? na : sTP1
sTP2   := longSig ? planTP2 : shortSig ? planTP2 : cleared ? na : sTP2
sTP3   := longSig ? planTP3 : shortSig ? planTP3 : cleared ? na : sTP3
hasSetup = sDir != 0

// ============================================================================
//  SHADOW MODE  (independent; reads real state, never writes it)
//  Opens ONE virtual trade per trend leg while the real engine is in WAIT,
//  tags the blocking filter, then measures the outcome on later bars only.
// ============================================================================
trendChanged = trend != trend[1]
okBar = barstate.isconfirmed
mtfOkDir  = trend == 1 ? (htf1Bull and htf2Bull) : trend == -1 ? (not htf1Bull and not htf2Bull) : false
zoneOkDir = trend == 1 ? inDiscount : trend == -1 ? inPremium : false
blockReason = (mtfFilter and not mtfOkDir) ? 1 : (needDiscount and not zoneOkDir) ? 2 : conf < entryThreshold ? 3 : 4

var int   shDir = 0
var float shSL = na
var float shTP1 = na
var float shTP2 = na
var float shTP3 = na
var int   shReached = 0
var int   shReason = 0
var bool  shLegUsed = false

shOpen = shadowOn and okBar and trend != 0 and not hasSetup and not longSig and not shortSig and shDir == 0 and not shLegUsed and validPlan
rNow  = shDir == 1 ? (high >= shTP3 ? 3 : high >= shTP2 ? 2 : high >= shTP1 ? 1 : 0) : shDir == -1 ? (low <= shTP3 ? 3 : low <= shTP2 ? 2 : low <= shTP1 ? 1 : 0) : 0
slNow = shDir == 1 ? (low <= shSL) : shDir == -1 ? (high >= shSL) : false
ambig = okBar and shDir != 0 and slNow and rNow > shReached
resolveTP3 = okBar and shDir != 0 and rNow >= 3 and not ambig
resolveSL  = okBar and shDir != 0 and slNow and not ambig
resolved = ambig or resolveTP3 or resolveSL
newReached = math.max(shReached, rNow)
win = resolveTP3 or (resolveSL and newReached >= 1)

var int shTotal = 0
var int shTP1c = 0
var int shTP2c = 0
var int shTP3c = 0
var int shSLc = 0
var int shAmbc = 0
shTotal := shTotal + (shOpen ? 1 : 0)
shTP3c  := shTP3c + (resolveTP3 ? 1 : 0)
shTP2c  := shTP2c + ((resolveSL and newReached == 2) ? 1 : 0)
shTP1c  := shTP1c + ((resolveSL and newReached == 1) ? 1 : 0)
shSLc   := shSLc + ((resolveSL and newReached == 0) ? 1 : 0)
shAmbc  := shAmbc + (ambig ? 1 : 0)

var int rMTFt = 0
var int rMTFw = 0
var int rZnt = 0
var int rZnw = 0
var int rCnt = 0
var int rCnw = 0
var int rBkt = 0
var int rBkw = 0
rMTFt := rMTFt + ((shOpen and blockReason == 1) ? 1 : 0)
rZnt  := rZnt + ((shOpen and blockReason == 2) ? 1 : 0)
rCnt  := rCnt + ((shOpen and blockReason == 3) ? 1 : 0)
rBkt  := rBkt + ((shOpen and blockReason == 4) ? 1 : 0)
rMTFw := rMTFw + ((win and shReason == 1) ? 1 : 0)
rZnw  := rZnw + ((win and shReason == 2) ? 1 : 0)
rCnw  := rCnw + ((win and shReason == 3) ? 1 : 0)
rBkw  := rBkw + ((win and shReason == 4) ? 1 : 0)

shDir     := shOpen ? trend : resolved ? 0 : shDir
shSL      := shOpen ? planSL : resolved ? na : shSL
shTP1     := shOpen ? planTP1 : resolved ? na : shTP1
shTP2     := shOpen ? planTP2 : resolved ? na : shTP2
shTP3     := shOpen ? planTP3 : resolved ? na : shTP3
shReason  := shOpen ? blockReason : resolved ? 0 : shReason
shReached := shOpen ? 0 : resolved ? 0 : newReached
shLegUsed := trendChanged ? false : shOpen ? true : shLegUsed

// ---- ALERTS -----------------------------------------------------------------
alertcondition(longSig,  "LONG Setup",  "Turhal AI PRO Lite: high-quality LONG setup")
alertcondition(shortSig, "SHORT Setup", "Turhal AI PRO Lite: high-quality SHORT setup")
alertcondition(bullBreak, "Bullish BOS/CHoCH", "Turhal AI PRO Lite: bullish structure break")
alertcondition(bearBreak, "Bearish BOS/CHoCH", "Turhal AI PRO Lite: bearish structure break")

// ---- 10) MAIN DASHBOARD (unchanged layout) ---------------------------------
scCol   = conf >= 70 ? bullCol : conf >= 40 ? color.new(#ffb300, 0) : color.gray
zoneTxt = na(pdEq) ? "-" : inDiscount ? "DISCOUNT" : "PREMIUM"
zoneCol = na(pdEq) ? color.gray : inDiscount ? discCol : premCol
setupTxt = hasSetup ? (sDir == 1 ? "LONG " : "SHORT ") + str.tostring(conf) + "%" : "-"
setupCol = hasSetup ? (sDir == 1 ? bullCol : bearCol) : color.gray
mtfAlignedNow = trend == 1 ? (htf1Bull and htf2Bull) : trend == -1 ? (not htf1Bull and not htf2Bull) : false
zoneNeed = needDiscount and not zoneOK
waitReason = (mtfFilter and not mtfAlignedNow) ? "MTF" : zoneNeed ? (trend == 1 ? "PREMIUM" : "DISCOUNT") : conf < entryThreshold ? "LOW CONF" : "BREAK"
stateTxt = hasSetup ? "READY" : trend == 0 ? "NO TREND" : not validPlan ? "INVALID" : "WAIT: " + waitReason
stateCol = hasSetup ? (sDir == 1 ? bullCol : bearCol) : trend == 0 ? color.gray : not validPlan ? bearCol : color.new(#ffb300, 0)
hd = color.new(color.black, 10)
kb = color.new(color.black, 25)
var table dash = table.new(position.top_right, 2, 13, border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)
table.cell(dash, 0, 0, "Turhal AI PRO", text_color = color.white, bgcolor = hd, text_size = size.small)
table.cell(dash, 1, 0, "Lite", text_color = color.white, bgcolor = hd, text_size = size.small)
table.cell(dash, 0, 1, "Trend", text_color = color.white, bgcolor = kb, text_size = size.small)
table.cell(dash, 1, 1, f_trTxt(trend), text_color = color.white, bgcolor = color.new(f_trCol(trend), 25), text_size = size.small)
table.cell(dash, 0, 2, "Bias", text_color = color.white, bgcolor = kb, text_size = size.small)
table.cell(dash, 1, 2, biasTxt, text_color = color.white, bgcolor = color.new(biasCol, 20), text_size = size.small)
table.cell(dash, 0, 3, "1H", text_color = color.white, bgcolor = kb, text_size = size.small)
table.cell(dash, 1, 3, f_biasTxt(htf1Bull), text_color = color.white, bgcolor = color.new(f_biasCol(htf1Bull), 25), text_size = size.small)
table.cell(dash, 0, 4, "4H", text_color = color.white, bgcolor = kb, text_size = size.small)
table.cell(dash, 1, 4, f_biasTxt(htf2Bull), text_color = color.white, bgcolor = color.new(f_biasCol(htf2Bull), 25), text_size = size.small)
table.cell(dash, 0, 5, "Zone", text_color = color.white, bgcolor = kb, text_size = size.small)
table.cell(dash, 1, 5, zoneTxt, text_color = color.white, bgcolor = color.new(zoneCol, 25), text_size = size.small)
table.cell(dash, 0, 6, "Signal", text_color = color.white, bgcolor = kb, text_size = size.small)
table.cell(dash, 1, 6, str.tostring(conf) + " %", text_color = color.white, bgcolor = color.new(scCol, 20), text_size = size.small)
table.cell(dash, 0, 7, "Setup", text_color = color.white, bgcolor = kb, text_size = size.small)
table.cell(dash, 1, 7, setupTxt, text_color = color.white, bgcolor = color.new(setupCol, 25), text_size = size.small)
table.cell(dash, 0, 8, "State", text_color = color.white, bgcolor = kb, text_size = size.small)
table.cell(dash, 1, 8, stateTxt, text_color = color.white, bgcolor = color.new(stateCol, 25), text_size = size.small)
table.cell(dash, 0, 9, "Entry", text_color = color.white, bgcolor = kb, text_size = size.tiny)
table.cell(dash, 1, 9, f_px(hasSetup ? sEntry : na), text_color = color.white, bgcolor = kb, text_size = size.tiny)
table.cell(dash, 0, 10, "SL", text_color = color.white, bgcolor = kb, text_size = size.tiny)
table.cell(dash, 1, 10, f_px(hasSetup ? sSL : na), text_color = color.white, bgcolor = hasSetup ? color.new(bearCol, 40) : kb, text_size = size.tiny)
table.cell(dash, 0, 11, "TP1 / TP2", text_color = color.white, bgcolor = kb, text_size = size.tiny)
table.cell(dash, 1, 11, f_px(hasSetup ? sTP1 : na) + " / " + f_px(hasSetup ? sTP2 : na), text_color = color.white, bgcolor = hasSetup ? color.new(bullCol, 40) : kb, text_size = size.tiny)
table.cell(dash, 0, 12, "TP3", text_color = color.white, bgcolor = kb, text_size = size.tiny)
table.cell(dash, 1, 12, f_px(hasSetup ? sTP3 : na), text_color = color.white, bgcolor = hasSetup ? color.new(bullCol, 40) : kb, text_size = size.tiny)

// ---- SHADOW PANEL (compact, bottom-left; does not overlap main dashboard) ---
shWins = shTP1c + shTP2c + shTP3c
shDenom = shWins + shSLc
shWR = shDenom > 0 ? int(math.round(shWins * 100.0 / shDenom)) : 0
shWRcol = shWR >= 55 ? bullCol : shWR >= 45 ? color.new(#ffb300, 0) : bearCol
sb = color.new(color.black, 20)
sk = color.new(color.black, 35)
var table sh = table.new(position.bottom_left, 2, 10, border_width = 1, frame_color = color.new(color.gray, 55), frame_width = 1)
table.cell(sh, 0, 0, f_sh("SHADOW"), text_color = color.white, bgcolor = sb, text_size = size.tiny)
table.cell(sh, 1, 0, f_sh(shadowOn ? "ON" : "OFF"), text_color = color.white, bgcolor = shadowOn ? color.new(bullCol, 30) : sk, text_size = size.tiny)
table.cell(sh, 0, 1, f_sh("Trades"), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 1, 1, f_sh(str.tostring(shTotal)), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 0, 2, f_sh("Win %"), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 1, 2, f_sh(str.tostring(shWR) + " %"), text_color = color.white, bgcolor = color.new(shWRcol, 25), text_size = size.tiny)
table.cell(sh, 0, 3, f_sh("Win / Loss"), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 1, 3, f_sh(str.tostring(shWins) + " / " + str.tostring(shSLc)), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 0, 4, f_sh("TP1/2/3"), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 1, 4, f_sh(str.tostring(shTP1c) + "/" + str.tostring(shTP2c) + "/" + str.tostring(shTP3c)), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 0, 5, f_sh("SL / AMB"), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 1, 5, f_sh(str.tostring(shSLc) + " / " + str.tostring(shAmbc)), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 0, 6, f_sh("blk MTF"), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 1, 6, f_sh(str.tostring(rMTFw) + " / " + str.tostring(rMTFt)), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 0, 7, f_sh("blk ZONE"), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 1, 7, f_sh(str.tostring(rZnw) + " / " + str.tostring(rZnt)), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 0, 8, f_sh("blk CONF"), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 1, 8, f_sh(str.tostring(rCnw) + " / " + str.tostring(rCnt)), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 0, 9, f_sh("blk BREAK"), text_color = color.white, bgcolor = sk, text_size = size.tiny)
table.cell(sh, 1, 9, f_sh(str.tostring(rBkw) + " / " + str.tostring(rBkt)), text_color = color.white, bgcolor = sk, text_size = size.tiny)
